---
/**
 * "Areas We Serve" — in-body, server-rendered internal-linking section.
 * Plain <a> tags to every service-area page so Googlebot has crawlable,
 * in-content referring links (not just nav/footer boilerplate).
 *
 * Props let the heading/intro flex per page without duplicating markup.
 *
 * `map` adds a stitched route map beside the list: every town at its real
 * position, pickup routes from the shop in Delta drawn as running stitches that sew
 * themselves outward along the highway corridors when the section scrolls in.
 * The map is decorative (aria-hidden); the list stays the accessible,
 * crawlable set of links. Hovering a town in either highlights it in both.
 */
import { serviceAreas } from '../data/service-areas';

interface Props {
  heading?: string;
  intro?: string;
  map?: boolean;
}

const {
  heading = 'Areas We Serve',
  intro = 'Based in Delta and serving gear, canvas, and upholstery repair across the Western Slope. Free local pickup in Montrose, Olathe & Delta — a small route fee everywhere else — and 3–7 day turnaround in each of these communities:',
  map = false,
} = Astro.props;

// ---- Map geometry (only used when `map` is set) ----------------------------
// Town centers. Projected equirectangular, with longitude scaled by
// cos(latitude) so distances read true at this latitude.
const GEO: Record<string, [lat: number, lon: number]> = {
  'montrose-co': [38.4783, -107.8762],
  'olathe-co': [38.605, -107.9823],
  'delta-co': [38.7422, -108.069],
  'grand-junction-co': [39.0639, -108.5506],
  'fruita-co': [39.1589, -108.729],
  'cedaredge-co': [38.9016, -107.9262],
  'hotchkiss-co': [38.7997, -107.7198],
  'paonia-co': [38.8683, -107.592],
  'ridgway-co': [38.1528, -107.7559],
  'ouray-co': [38.0228, -107.6714],
  'telluride-co': [37.9375, -107.8123],
  'gunnison-co': [38.5458, -106.9253],
  'crested-butte-co': [38.8697, -106.9878],
};
const LON0 = -108.85, LON1 = -106.8, LAT0 = 37.85, LAT1 = 39.25;
const K = Math.cos((((LAT0 + LAT1) / 2) * Math.PI) / 180);
const W = 560;
const S = W / ((LON1 - LON0) * K);
const H = Math.round((LAT1 - LAT0) * S);
const px = (lat: number, lon: number) => [
  Math.round((lon - LON0) * K * S * 10) / 10,
  Math.round((LAT1 - lat) * S * 10) / 10,
];
const pos = Object.fromEntries(Object.entries(GEO).map(([slug, [lat, lon]]) => [slug, px(lat, lon)]));

// The shop. Routes sew outward from here, and it carries the ✦.
const HUB = 'delta-co';

// Pickup routes, town to town along the highway corridors out of Delta.
// `depth` is how many hops from the hub, which staggers the sewing outward.
const ROUTES: [from: string, to: string, depth: number][] = [
  ['delta-co', 'olathe-co', 0],
  ['olathe-co', 'montrose-co', 1],
  ['montrose-co', 'ridgway-co', 2],
  ['ridgway-co', 'ouray-co', 3],
  ['ridgway-co', 'telluride-co', 3],
  ['montrose-co', 'gunnison-co', 2],
  ['gunnison-co', 'crested-butte-co', 3],
  ['delta-co', 'grand-junction-co', 0],
  ['grand-junction-co', 'fruita-co', 1],
  ['delta-co', 'cedaredge-co', 0],
  ['delta-co', 'hotchkiss-co', 0],
  ['hotchkiss-co', 'paonia-co', 1],
];
const townDepth: Record<string, number> = { [HUB]: -1 };
for (const [, to, d] of ROUTES) townDepth[to] = d;

const FREE_PICKUP = new Set(['montrose-co', 'olathe-co', 'delta-co']);

// Label placement where the default (to the right) would collide or clip.
const LABEL: Record<string, { dx: number; dy: number; anchor: 'start' | 'middle' | 'end' }> = {
  'fruita-co': { dx: 0, dy: -11, anchor: 'middle' },
  'cedaredge-co': { dx: 0, dy: -11, anchor: 'middle' }, // to the right it crowds Paonia
  'delta-co': { dx: -17, dy: 5, anchor: 'end' }, // the hub: clear of its ring
  'telluride-co': { dx: -10, dy: 4, anchor: 'end' },
  'gunnison-co': { dx: -10, dy: 4, anchor: 'end' },
  'crested-butte-co': { dx: 0, dy: -11, anchor: 'middle' }, // left would hit Paonia
  'montrose-co': { dx: 9, dy: 17, anchor: 'start' }, // under the route east to Gunnison
};
const label = (slug: string) => LABEL[slug] ?? { dx: 10, dy: 4, anchor: 'start' as const };

const mapTowns = serviceAreas.filter((a) => pos[a.slug]);
const [mx, my] = pos[HUB];

// Faint survey graticule, and a 20-mile scale bar (1° latitude ≈ 69 miles).
const latLines = [38, 38.5, 39].map((lat) => px(lat, LON0)[1]);
const lonLines = [-108.5, -108, -107.5, -107].map((lon) => px(LAT0, lon)[0]);
const scaleLen = Math.round((20 / 69) * S);
---

<section
  class:list={['areas-served', { 'has-map': map }]}
  aria-labelledby="areas-served-heading"
  data-areas
>
  <div class="wrap">
    <div class="as-head">
      <div class="section-num">§ Service Area</div>
      <h2 id="areas-served-heading">{heading}</h2>
      <p class="as-intro">{intro}</p>
    </div>
    <div class="as-body">
      <ul class="as-grid">
        {serviceAreas.map((area) => (
          <li>
            <a href={`/service-areas/${area.slug}/`} data-town={area.slug}>
              <span class="as-city">{area.cityName}, {area.state}</span>
              <span class="as-region">{area.region}</span>
            </a>
          </li>
        ))}
      </ul>

      {map && (
        <figure class="as-map" aria-hidden="true">
          <svg viewBox={`0 0 ${W} ${H}`} role="presentation" focusable="false">
            <defs>
              {ROUTES.map(([from, to], i) => (
                <mask id={`as-route-mask-${i}`} maskUnits="userSpaceOnUse">
                  <path
                    class="as-draw"
                    style={`--d: ${townDepth[to]}`}
                    d={`M${pos[from][0]} ${pos[from][1]} L${pos[to][0]} ${pos[to][1]}`}
                    pathLength="1"
                  />
                </mask>
              ))}
            </defs>

            <g class="as-graticule">
              {latLines.map((y) => <line x1="0" x2={W} y1={y} y2={y} />)}
              {lonLines.map((x) => <line x1={x} x2={x} y1="0" y2={H} />)}
            </g>

            {/* Free-pickup zone: a soft band through Montrose, Olathe and Delta. */}
            <path
              class="as-zone"
              d={`M${pos['montrose-co'][0]} ${pos['montrose-co'][1]} L${pos['olathe-co'][0]} ${pos['olathe-co'][1]} L${pos['delta-co'][0]} ${pos['delta-co'][1]}`}
            />

            <g class="as-routes">
              {ROUTES.map(([from, to], i) => (
                <path
                  class="as-route"
                  data-town={to}
                  mask={`url(#as-route-mask-${i})`}
                  d={`M${pos[from][0]} ${pos[from][1]} L${pos[to][0]} ${pos[to][1]}`}
                />
              ))}
            </g>

            <g class="as-towns">
              {mapTowns.map((area) => {
                const [x, y] = pos[area.slug];
                const l = label(area.slug);
                const hub = area.slug === HUB;
                return (
                  <a href={`/service-areas/${area.slug}/`} tabindex="-1" data-town={area.slug}>
                    <g
                      class:list={['as-town', { 'is-free': FREE_PICKUP.has(area.slug), 'is-hub': hub }]}
                      style={`--d: ${townDepth[area.slug] ?? 0}`}
                    >
                      <circle class="as-hit" cx={x} cy={y} r="16" />
                      {hub && <circle class="as-hub-ring" cx={x} cy={y} r="13" />}
                      <circle class="as-dot" cx={x} cy={y} r={hub ? 9 : FREE_PICKUP.has(area.slug) ? 6 : 4.5} />
                      <text x={x + l.dx} y={y + l.dy} text-anchor={l.anchor}>{area.cityName}</text>
                    </g>
                  </a>
                );
              })}
            </g>

            <text class="as-knot" x={mx} y={my + 4.5} text-anchor="middle">✦</text>

            <g class="as-compass" transform={`translate(${W - 26} 30)`}>
              <path d="M0 -16 L6 6 L0 2 L-6 6 Z" />
              <text y="22" text-anchor="middle">N</text>
            </g>
            <g class="as-scale" transform={`translate(16 ${H - 18})`}>
              <line x1="0" x2={scaleLen} y1="0" y2="0" />
              <line x1="0" x2="0" y1="-4" y2="4" />
              <line x1={scaleLen} x2={scaleLen} y1="-4" y2="4" />
              <text x={scaleLen + 8} y="4">20 mi</text>
            </g>
          </svg>
          <figcaption class="as-legend">
            <span><i class="as-key is-free"></i>Free pickup</span>
            <span><i class="as-key"></i>Small route fee</span>
          </figcaption>
        </figure>
      )}
    </div>
  </div>
</section>

<style>
  .areas-served {
    padding: 80px 0;
    background: var(--canvas);
    border-top: 2px solid var(--charcoal);
  }
  .as-head { margin-bottom: 36px; max-width: 64ch; }
  .areas-served h2 {
    font-size: clamp(30px, 4.2vw, 52px);
    letter-spacing: -0.03em;
    margin-top: 14px;
    text-wrap: balance;
  }
  .as-intro {
    margin: 22px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }
  .as-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .as-grid li {
    border-bottom: 1px solid var(--rule-strong);
  }
  .as-grid a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 2px;
    text-decoration: none;
    color: var(--charcoal);
    transition: padding-left 0.14s ease, color 0.14s ease;
  }
  .as-grid a:hover { padding-left: 8px; color: var(--rust); }
  .as-city {
    font-family: var(--f-serif);
    font-weight: 500;
    font-size: clamp(19px, 2.4vw, 24px);
    letter-spacing: -0.01em;
  }
  .as-region {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: right;
    flex-shrink: 0;
  }
  @media (min-width: 700px) {
    .as-grid { grid-template-columns: repeat(2, 1fr); column-gap: 56px; }
  }
  @media (min-width: 1040px) {
    .as-grid { grid-template-columns: repeat(3, 1fr); column-gap: 48px; }
  }

  /* ---------------- With the map ---------------- */
  .has-map .as-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .has-map .as-map { order: -1; }
  @media (min-width: 1040px) {
    .has-map .as-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }
    .has-map .as-map { order: 0; position: sticky; top: 110px; }
    /* Two columns of towns beside the map instead of three across. */
    .has-map .as-grid { grid-template-columns: repeat(2, 1fr); column-gap: 36px; }
  }
  /* Half-width columns are too narrow for town and region side by side, so
     the region sits under the town. */
  .has-map .as-grid a {
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 14px 2px;
  }
  .has-map .as-region { text-align: left; }
  /* Highlight shared with the map. */
  .has-map .as-grid a.is-hot { padding-left: 8px; color: var(--rust); }

  .as-map { margin: 0; max-width: 560px; width: 100%; }
  .as-map svg { display: block; width: 100%; height: auto; overflow: visible; }

  .as-graticule line { stroke: var(--rule-strong); stroke-width: 1; stroke-dasharray: 2 6; }
  .as-zone {
    fill: none;
    stroke: var(--rust);
    stroke-opacity: 0.12;
    stroke-width: 44;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Routes: a dashed running stitch revealed by a mask whose solid stroke is
     drawn along the same path, so the stitches appear without stretching. */
  .as-draw {
    fill: none;
    stroke: #fff;
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .as-route {
    fill: none;
    stroke: var(--rust);
    stroke-width: 2;
    stroke-dasharray: 7 5;
    stroke-linecap: round;
    transition: stroke-width 0.2s ease;
  }
  .as-route.is-hot { stroke-width: 3.5; }

  .as-hit { fill: transparent; }
  .as-dot {
    fill: var(--canvas-light);
    stroke: var(--charcoal);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), fill 0.2s ease;
  }
  .as-town.is-free .as-dot { fill: var(--rust); stroke: var(--rust); }
  .as-hub-ring { fill: none; stroke: var(--rust); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .as-town text {
    font-family: var(--f-serif);
    font-size: 15px;
    font-weight: 500;
    fill: var(--charcoal);
    letter-spacing: -0.01em;
    transition: fill 0.2s ease;
  }
  .as-town.is-hub text { font-weight: 700; }
  .as-towns a { cursor: pointer; }
  .as-towns a.is-hot .as-dot { transform: scale(1.6); }
  .as-towns a.is-hot text { fill: var(--rust); }
  /* The hub's dot sits under its ✦ knot. */
  .as-town.is-hub .as-dot { fill: var(--charcoal); stroke: var(--charcoal); }
  .as-knot { fill: var(--rust); font-family: var(--f-sans); font-size: 12px; pointer-events: none; }

  .as-compass path { fill: var(--charcoal); }
  .as-compass text,
  .as-scale text {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    fill: var(--muted);
  }
  .as-scale line { stroke: var(--charcoal); stroke-width: 1.5; }
  /* The map scales down with the screen, so its type is set larger in map
     units on phones to stay readable (~11–12px on screen). */
  @media (max-width: 700px) {
    .as-town text { font-size: 17px; }
    .as-compass text,
    .as-scale text { font-size: 14px; }
  }

  .as-legend {
    display: flex;
    gap: 22px;
    margin-top: 14px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .as-legend span { display: inline-flex; align-items: center; gap: 8px; }
  .as-key {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--charcoal);
    background: var(--canvas-light);
  }
  .as-key.is-free { background: var(--rust); border-color: var(--rust); }

  /* ---------- Sewing in, only when scripts run ---------- */
  :global(.js) .has-map .as-draw {
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.9s cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: calc(0.3s + var(--d, 0) * 0.55s);
  }
  :global(.js) .has-map.is-visible .as-draw { stroke-dashoffset: 0; }
  :global(.js) .has-map .as-town {
    opacity: 0;
    transition: opacity 0.4s ease;
    transition-delay: calc(0.3s + (var(--d, 0) + 1) * 0.55s);
  }
  :global(.js) .has-map .as-town.is-hub { transition-delay: 0.1s; }
  :global(.js) .has-map.is-visible .as-town { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .has-map .as-draw { stroke-dashoffset: 0; transition: none; }
    :global(.js) .has-map .as-town { opacity: 1; transition: none; }
  }
</style>

<script>
  for (const section of document.querySelectorAll<HTMLElement>('[data-areas].has-map')) {
    // Sew the routes in when the map comes into view.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            section.classList.add('is-visible');
            io.disconnect();
          }
        },
        { threshold: 0.25 },
      );
      io.observe(section.querySelector('.as-map') ?? section);
    } else {
      section.classList.add('is-visible');
    }

    // Hovering or focusing a town in the list or on the map lights it up in both.
    const setHot = (slug: string | null) => {
      section.querySelectorAll('[data-town].is-hot').forEach((el) => el.classList.remove('is-hot'));
      if (slug) section.querySelectorAll(`[data-town="${slug}"]`).forEach((el) => el.classList.add('is-hot'));
    };
    const townOf = (target: EventTarget | null) =>
      (target as Element | null)?.closest?.('[data-town]')?.getAttribute('data-town') ?? null;
    section.addEventListener('pointerover', (e) => setHot(townOf(e.target)));
    section.addEventListener('pointerleave', () => setHot(null));
    section.addEventListener('focusin', (e) => setHot(townOf(e.target)));
    section.addEventListener('focusout', () => setHot(null));
  }
</script>
