---
/**
 * Portfolio cards that show the fix. A job with both photos opens on the
 * before; hover (or keyboard focus) sews the after in behind a running-stitch
 * seam. On devices without hover each card sews itself in once, a beat after
 * it scrolls mostly into view. Jobs with only one photo show it plainly.
 *
 * Same --p mechanism as the hero plate: one registered custom property drives
 * the after photo's clip and the seam's position together.
 */
import PortfolioPhoto from './PortfolioPhoto.astro';
import { pickThumbnail, categoryLabel, type PortfolioItemWithSlug } from '../lib/portfolio';

interface Props {
  items: PortfolioItemWithSlug[];
  /** Light text, for dark sections. */
  dark?: boolean;
  /** 'two': two larger columns with a link line under each title. */
  layout?: 'three' | 'two';
  /** Text for the link line under each title (two-column layout). */
  arrow?: string;
  /** Each card fades up as it scrolls into view. */
  revealEach?: boolean;
  /** Tag each card with its category and a view-transition name, for filtering. */
  filterable?: boolean;
  /** Passed through for a page's reveal script (e.g. data-reveal). */
  [attr: `data-${string}`]: unknown;
  style?: string;
}

const { items, dark = false, layout = 'three', arrow, revealEach = false, filterable = false, style, ...attrs } = Astro.props;
const sizes =
  layout === 'two'
    ? '(max-width: 719px) 100vw, (max-width: 1180px) 50vw, 566px'
    : '(max-width: 719px) 100vw, (max-width: 1180px) 33vw, 370px';
---

<ul class:list={['sewn-cards', { 'is-dark': dark, 'is-two': layout === 'two', 'reveal-each': revealEach }]} style={style} {...attrs}>
  {items.map((p, i) => {
    const pair = p.before_image_url && p.after_image_url;
    const thumb = pickThumbnail(p);
    return (
      <li
        class="sc-card"
        data-cat={filterable ? p.category : undefined}
        style={[
          revealEach ? `--sc-i: ${i % (layout === 'two' ? 2 : 3)}` : '',
          filterable ? `view-transition-name: sc-${p.slug.slice(0, 60)}` : '',
        ].filter(Boolean).join('; ') || undefined}
      >
        <a href={`/portfolio/${p.slug}/`}>
          {pair ? (
            <div class="sc-media has-pair" data-sew-on-view>
              <PortfolioPhoto class="sc-before" src={p.before_image_url!} alt={`Before: ${p.title}`} sizes={sizes} />
              <PortfolioPhoto class="sc-after" src={p.after_image_url!} alt={`After: ${p.title}`} sizes={sizes} />
              <span class="sc-seam" aria-hidden="true"></span>
              <span class="sc-tag" aria-hidden="true"><span class="sc-tag-before">Before</span><span class="sc-tag-after">After</span></span>
            </div>
          ) : (
            <div class:list={['sc-media', { 'is-empty': !thumb }]}>
              {thumb && <PortfolioPhoto src={thumb} alt={`${p.title} — ${categoryLabel(p.category)}`} sizes={sizes} />}
            </div>
          )}
          <span class="sc-category">{categoryLabel(p.category)}</span>
          <h3 class="sc-title">{p.title}</h3>
          {arrow && <span class="sc-arrow">{arrow}</span>}
        </a>
      </li>
    );
  })}
</ul>

<style>
  @property --p {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 0%;
  }

  .sewn-cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .sc-card a { display: block; text-decoration: none; color: inherit; }
  .sc-media {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--canvas-dark);
    border-radius: 2px;
    margin-bottom: 16px;
  }
  .sc-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .sc-card a:hover .sc-media :global(img) { transform: scale(1.03); }

  .sc-media.has-pair {
    --p: 0%;
    position: relative;
    transition: --p 0.9s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .has-pair :global(img) { position: absolute; inset: 0; }
  .has-pair :global(.sc-after) { clip-path: inset(0 calc(100% - var(--p)) 0 0); }
  .sc-seam {
    position: absolute;
    inset: 0;
    transform: translateX(var(--p));
    pointer-events: none;
  }
  .sc-seam::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0; /* at --p 100% this sits just past the right edge, clipped away */
    width: 3px;
    background: repeating-linear-gradient(180deg, var(--rust) 0 9px, transparent 9px 15px);
    opacity: var(--seam-o, 0);
    transition: opacity 0.2s ease;
  }
  .sc-tag {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 4px 9px;
    border-radius: 2px;
    background: rgba(28, 28, 26, 0.78);
    color: var(--canvas);
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    display: grid;
  }
  .sc-tag > span { grid-area: 1 / 1; transition: opacity 0.3s ease; }
  .sc-tag-after { opacity: 0; }
  .sc-media.has-pair.is-sewn,
  .sc-card a:focus-visible .has-pair { --p: 100%; --seam-o: 1; }
  .is-sewn .sc-tag-before,
  .sc-card a:focus-visible .sc-tag-before { opacity: 0; }
  .is-sewn .sc-tag-after,
  .sc-card a:focus-visible .sc-tag-after { opacity: 1; }
  @media (hover: hover) {
    .sc-card a:hover .has-pair { --p: 100%; --seam-o: 1; }
    .sc-card a:hover .sc-tag-before { opacity: 0; }
    .sc-card a:hover .sc-tag-after { opacity: 1; }
  }

  .sc-category {
    display: block;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 8px;
  }
  .sc-title {
    font-family: var(--f-serif);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--charcoal);
    text-wrap: balance;
  }
  .is-dark .sc-category { color: #e8cda9; }
  .is-dark .sc-title { color: var(--canvas-light); }
  @media (min-width: 720px) {
    .sewn-cards { grid-template-columns: repeat(3, 1fr); gap: 36px; }
  }

  /* Two larger columns, with a link line under each title. */
  .is-two { gap: 36px 28px; }
  .is-two .sc-media { margin-bottom: 18px; }
  .is-two .sc-title { font-size: clamp(22px, 2.6vw, 28px); margin-bottom: 12px; }
  .sc-arrow {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--charcoal);
    border-bottom: 1px solid var(--charcoal);
    padding-bottom: 2px;
    transition: color 0.12s ease, border-color 0.12s ease, letter-spacing 0.3s ease;
  }
  .sc-card a:hover .sc-arrow { color: var(--rust); border-bottom-color: var(--rust); letter-spacing: 0.2em; }
  @media (min-width: 720px) {
    .is-two { grid-template-columns: repeat(2, 1fr); gap: 64px 48px; }
  }
  @media (min-width: 1100px) {
    .is-two { gap: 80px 56px; }
  }
  /* A job with no photo yet. */
  .sc-media.is-empty { background: repeating-linear-gradient(45deg, #c9b590 0 14px, #d4c3a0 14px 28px); }

  /* Cards fade up one by one as they arrive (scripts only). */
  :global(.js) .reveal-each .sc-card {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--sc-i, 0) * 0.1s);
  }
  :global(.js) .reveal-each .sc-card.is-visible { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .sc-media.has-pair { transition: none; }
    :global(.js) .reveal-each .sc-card { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // Where there's no hover (phones), sew each card's fix in once, a beat after
  // it's mostly on screen. Hover devices use :hover instead.
  const noHover = window.matchMedia('(hover: none)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cards = document.querySelectorAll<HTMLElement>('[data-sew-on-view]');
  if (noHover && cards.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const card = entry.target as HTMLElement;
          io.unobserve(card);
          window.setTimeout(() => card.classList.add('is-sewn'), reduceMotion ? 0 : 500);
        }
      },
      { threshold: 0.6 },
    );
    cards.forEach((c) => io.observe(c));
  }

  // Per-card fade-up for lists that ask for it.
  const revealCards = document.querySelectorAll<HTMLElement>('.reveal-each > .sc-card');
  if (revealCards.length && 'IntersectionObserver' in window) {
    const rio = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          rio.unobserve(entry.target);
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
    );
    revealCards.forEach((c) => rio.observe(c));
  } else {
    revealCards.forEach((c) => c.classList.add('is-visible'));
  }
</script>
