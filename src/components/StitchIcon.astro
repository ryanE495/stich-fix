---
/**
 * A line icon drawn in running stitches that embroiders itself in.
 *
 * `paths` are 32×32 path data. Each is drawn twice: once dashed (the stitches)
 * and once solid inside a mask whose stroke draws along the path, so the
 * stitches appear in order without stretching. The parent's reveal decides
 * when: the stitching runs when an ancestor gains .is-visible. Without
 * scripts, or with reduced motion, the icon is simply there.
 */
interface Props {
  /** Unique on the page; used for the mask id. */
  id: string;
  paths: string[];
  /** Seconds to wait after the ancestor is revealed. */
  delay?: number;
}

const { id, paths, delay = 0 } = Astro.props;
const maskId = `stitch-icon-${id}`;
---

<svg class="stitch-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false" style={`--delay: ${delay}s`}>
  <defs>
    <mask id={maskId} maskUnits="userSpaceOnUse" x="-2" y="-2" width="36" height="36">
      {paths.map((d) => <path class="si-reveal" d={d} pathLength="1" />)}
    </mask>
  </defs>
  <g mask={`url(#${maskId})`}>
    {paths.map((d) => <path class="si-stitch" d={d} />)}
  </g>
</svg>

<style>
  .stitch-icon { width: 24px; height: 24px; display: block; overflow: visible; }
  .si-stitch {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-dasharray: 2.4 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .si-reveal {
    fill: none;
    stroke: #fff;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  /* With scripts: unstitched until an ancestor is revealed. */
  :global(.js) .si-reveal {
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.1s cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: var(--delay, 0s);
  }
  :global(.js .is-visible) .si-reveal { stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .si-reveal { transition: none; stroke-dashoffset: 0 !important; }
  }
</style>
