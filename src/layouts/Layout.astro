---
// Self-hosted variable fonts (replaces the Google Fonts CDN <link>).
// font-display: swap is already set by @fontsource on these declarations,
// and the metric-adjusted fallbacks live in global.css so the system font
// shown before swap doesn't trigger a layout shift.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/inter';

// The two font files behind above-the-fold text (body copy and headings /
// brand), preloaded so they start downloading with the HTML instead of after
// the CSS is parsed. Mobile LCP is text, and it repaints when these arrive.
// Same source files the @fontsource CSS points at, so Vite emits one asset each.
import frauncesNormalWoff2 from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import interNormalWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, seo, type NavKey } from '../config/site';

/** One rung of the breadcrumb trail. `path` is site-relative, e.g. '/services/'. */
export interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  preloadImage?: string;
  jsonLd?: object | object[];
  active?: NavKey;
  /**
   * Ancestor trail for BreadcrumbList schema, excluding Home (added
   * automatically) and excluding the current page (appended automatically
   * from `title`/`canonicalPath`). Lets deep pages render a breadcrumb trail
   * in search results instead of a bare URL.
   */
  breadcrumbs?: Crumb[];
  /** Keep transactional pages (forms, confirmations) out of search results. */
  noindex?: boolean;
}

const {
  // Keyword + location first, brand last — a local searcher scans for the
  // service, not the shop name they don't know yet.
  title = `Gear & Canvas Repair, Montrose CO | ${site.name}`,
  description = site.description,
  canonicalPath,
  ogImage = seo.ogImage,
  preloadImage,
  jsonLd,
  active,
  breadcrumbs,
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url).toString();
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Strip any " — …" / " – …" / " | brand" suffix so the final crumb reads as a
// short page name rather than the full SEO title.
const crumbLeafName = title.split(/\s+[—–|]\s+/)[0];

if (breadcrumbs?.length) {
  const trail = [
    { name: 'Home', path: '/' },
    ...breadcrumbs,
    { name: crumbLeafName, path: canonicalPath ?? Astro.url.pathname },
  ];
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: trail.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.path, site.url).toString(),
    })),
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

    <link rel="preload" href={frauncesNormalWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interNormalWoff2} as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicons / PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#201E1C" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <!--
      Microsoft Clarity, started after the page has loaded and the browser is
      idle. Loading it async from the head wasn't enough: it downloaded before
      the first paint and its DOM snapshot held the main thread while the text
      was waiting to render, adding ~1.3s to mobile LCP. The cost of waiting is
      that sessions which leave before the load event aren't recorded.
    -->
    <script is:inline>
      (function () {
        function startClarity() {
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "wmnroq6gcj");
        }
        function whenIdle() {
          if ('requestIdleCallback' in window) requestIdleCallback(startClarity, { timeout: 4000 });
          else setTimeout(startClarity, 2000);
        }
        if (document.readyState === 'complete') whenIdle();
        else window.addEventListener('load', whenIdle, { once: true });
      })();
    </script>
  </head>
  <body>
    <Nav active={active} />
    <slot />
    <Footer />
  </body>
</html>
