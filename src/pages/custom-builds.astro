    .intro-body strong, .cat-card::after, .cat-icon { transition: none; }
  }
</style>

<script>
  // Sections fade up, seams sew in, and stitched icons embroider as they arrive.
  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal], [data-seam]');
  if (reveals.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -10% 0px' },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-visible'));
  }
</script>
