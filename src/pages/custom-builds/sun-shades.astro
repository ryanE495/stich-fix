---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { site, seo } from '../../config/site';
import { serviceAreas, HERO } from '../../data/service-areas';
import { fetchPublishedPortfolio, withSlugs, pickThumbnail } from '../../lib/portfolio';

const canonicalPath = '/custom-builds/sun-shades/';

// Sun shade / awning work is pulled live from the portfolio rather than
// hardcoded, so the hero image and gallery below stay accurate as new jobs
// get published under the 'awning' category — no code change needed later.
const allPortfolio = withSlugs(await fetchPublishedPortfolio());
const sunShadeWork = allPortfolio.filter((p) => p.category === 'awning');

const heroPortfolioItem = sunShadeWork[0];
const heroImage = (heroPortfolioItem && pickThumbnail(heroPortfolioItem)) || HERO.shop;
const heroImageAlt = heroPortfolioItem
  ? `${heroPortfolioItem.title} — custom sun shade work by Western Slope Stitchworks`
  : 'Industrial sewing machine and canvas work bench at the Western Slope Stitchworks shop';

const whyCustom = [
  { name: 'Exact fit to your space', body: 'Built to the real measurements of your patio, deck, or camp setup — not the closest stock rectangle.' },
  { name: 'Wind-ready hardware', body: 'Reinforced grommets, hems, and buckle points sewn to hold under load — not what comes stapled to a patio-store shade.' },
  { name: 'Fabric & color options', body: 'Lineup is still being finalized — ask what’s available when you send your dimensions.' },
  { name: 'Built locally, fast turnaround', body: 'Sewn here in Montrose. No shipping a shade cross-country, no waiting on a warehouse order.' },
];

const sizeTiers = [
  { name: 'Small sun shade (up to roughly 10’ × 10’)', price: 'Quote by size' },
  { name: 'Medium sun shade (up to roughly 14’ × 16’)', price: 'Quote by size' },
  { name: 'Large or custom-shaped sun shade', price: 'Quote by size' },
  { name: 'Grommet, buckle & wind-tie reinforcement', price: 'Quote by size' },
];

const howItWorks = [
  { title: 'Send Dimensions or a Photo', body: 'Text the measurements of the space, or just a photo — I can usually work out the rest.' },
  { title: 'Real Quote in 24 Hours', body: 'I’ll come back with an honest number and a turnaround date. No estimate fee.' },
  { title: 'Build', body: 'Cut and sewn on the same industrial machine that handles every job in the shop.' },
  { title: 'Pickup or Install', body: 'Grab it in Montrose, or arrange pickup along a Western Slope route.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Custom Sun Shades',
  serviceType: 'Custom Sun Shade & Awning Fabrication',
  description:
    'Custom-built sun shades sewn to the exact dimensions of the space, in fabric built to hold up to Western Slope sun and wind. Reinforced grommets, hems, and wind-tie hardware.',
  url: `${site.url}${canonicalPath}`,
  provider: {
    '@type': 'LocalBusiness',
    '@id': seo.businessId,
  },
  areaServed: serviceAreas.map((a) => ({
    '@type': 'City',
    name: `${a.cityName}, ${a.state}`,
  })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Custom Sun Shade Sizes',
    itemListElement: sizeTiers.map((t) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: t.name },
    })),
  },
};
---

<Layout
  active="custom-builds"
  title="Custom Sun Shades — Made-to-Fit Awnings | Western Slope Stitchworks"
  description="Custom-built sun shades sewn to the exact dimensions of your space, in fabric built for Western Slope sun and wind. Text a photo or your dimensions, get a real quote in 24 hours."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="page-head">
    <div class="wrap">
      <div class="section-num">§ Custom Builds</div>
      <h1>Custom <em>Sun Shades.</em></h1>
      <div class="page-head-grid">
        <div class="page-head-text">
          <p class="page-tagline">Off-the-shelf shades never fit right. I build these to the exact dimensions of your space, in fabric that holds up to Western Slope sun and wind.</p>
          <div class="page-ctas">
            <a href={site.phoneHref} class="btn">Text a photo to {site.phoneDisplay}</a>
            <a href="/contact" class="btn btn-secondary">Use the contact form &rarr;</a>
          </div>
        </div>
        <div class="page-head-media">
          <div class="page-head-image-frame">
            <Image
              class="page-head-image"
              src={heroImage}
              width={1280}
              height={960}
              widths={[480, 768, 1280]}
              sizes="(max-width: 720px) 100vw, (max-width: 1180px) 45vw, 540px"
              format="webp"
              quality={82}
              alt={heroImageAlt}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
          <div class="page-head-caption">
            <span>Plate 01 / Sun Shade</span>
            <span>{site.location}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY CUSTOM -->
  <section class="why">
    <div class="wrap">
      <div class="why-head">
        <div class="section-num">§ Why Custom</div>
        <h2>Why Not Just Buy One?</h2>
      </div>
      <ul class="why-list">
        {whyCustom.map((item, i) => (
          <li>
            <span class="why-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="why-text"><strong>{item.name}</strong> — {item.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PRICING -->
  <section class="cat">
    <div class="wrap">
      <div class="cat-head">
        <span class="cat-num">§ Pricing</span>
        <h2>Sun Shade Pricing</h2>
      </div>
      <ul class="price-list">
        {sizeTiers.map((item) => (
          <li class="price-item">
            <span class="pi-name">{item.name}</span>
            <span class="pi-price">{item.price}</span>
          </li>
        ))}
      </ul>
      <p class="cat-foot">Real numbers are still being worked out size by size — nobody's publishing a range until the math is right. Text your dimensions and I'll quote it directly, same as everything else in the shop.</p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how">
    <div class="wrap">
      <h2>How It Works</h2>
      <div class="how-grid">
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 12l2.2-3.2h4.2L14.6 12H24a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V14a2 2 0 0 1 2-2z" />
              <circle cx="16" cy="19" r="4" />
            </svg>
          </div>
          <h4>{howItWorks[0].title}</h4>
          <p>{howItWorks[0].body}</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 8h20v14H14l-5 5v-5H6z" />
              <path d="M12 14h10M12 18h7" />
            </svg>
          </div>
          <h4>{howItWorks[1].title}</h4>
          <p>{howItWorks[1].body}</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="16" cy="16" r="4" />
              <path d="M16 6v3M16 23v3M6 16h3M23 16h3M9.5 9.5l2 2M20.5 20.5l2 2M9.5 22.5l2-2M20.5 11.5l2-2" />
            </svg>
          </div>
          <h4>{howItWorks[2].title}</h4>
          <p>{howItWorks[2].body}</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 28s9-8 9-15a9 9 0 1 0-18 0c0 7 9 15 9 15z" />
              <circle cx="16" cy="13" r="3.25" />
            </svg>
          </div>
          <h4>{howItWorks[3].title}</h4>
          <p>{howItWorks[3].body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="gallery">
    <div class="wrap">
      <div class="gallery-head">
        <div class="section-num">§ Recent Sun Shade Work</div>
        <h2>Real Jobs, <em>Real Fixes.</em></h2>
        <p class="gallery-intro">Before-and-after photos from actual sun shade and awning work that's come through the shop. More go up here as new jobs wrap.</p>
      </div>
      {sunShadeWork.length > 0 ? (
        <ul class="portfolio-grid">
          {sunShadeWork.map((item) => {
            const thumb = pickThumbnail(item);
            return (
              <li class="portfolio-card">
                <a href={`/portfolio/${item.slug}/`}>
                  <div class="card-media">
                    {thumb ? (
                      <img src={thumb} alt={`${item.title} — ${item.category}`} loading="lazy" decoding="async" />
                    ) : (
                      <div class="card-media-empty" aria-hidden="true"></div>
                    )}
                  </div>
                  <div class="card-body">
                    <span class="card-category">Awning &amp; Sun Shade</span>
                    <h3 class="card-title">{item.title}</h3>
                    <span class="card-arrow">See the build &rarr;</span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="gallery-empty">Photos from sun shade jobs are getting added to the portfolio. Text a photo of your own project and it might be the next one up.</p>
      )}
      <a href="/portfolio/" class="btn btn-secondary gallery-cta">See the full portfolio &rarr;</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="city-cta">
    <div class="wrap">
      <div class="city-cta-inner">
        <div class="section-num">§ Next Step</div>
        <h2>Text your dimensions to <em>{site.phoneDisplay}</em><br />— quote back in 24 hours.</h2>
        <p>Send a photo of the space or the measurements you've got, and I'll come back with a real number and a turnaround date. No estimate fee, no obligation.</p>
        <div class="city-cta-row">
          <a href={site.phoneHref} class="btn">Call or Text {site.phoneDisplay}</a>
          <a href="/contact" class="btn btn-secondary">Use the contact form &rarr;</a>
        </div>
        <div class="city-cta-small">$25 shop minimum &middot; {site.hours} &middot; {site.location}</div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- HERO (matches services.astro / custom-builds.astro page-head) ---------- */
  .page-head {
    padding: 72px 0 56px;
    background: var(--canvas-light);
    border-bottom: 2px solid var(--charcoal);
  }
  .page-head h1 {
    font-size: clamp(48px, 8.2vw, 124px);
    line-height: 0.94;
    letter-spacing: -0.04em;
    font-weight: 600;
    margin-top: 18px;
    max-width: 16ch;
    text-wrap: balance;
  }
  .page-head h1 em { font-style: italic; font-weight: 400; color: var(--river); }
  .page-head-grid {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--rule-strong);
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: start;
  }
  .page-tagline {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
    max-width: 52ch;
    color: var(--ink);
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 500;
  }
  .page-ctas {
    margin-top: 28px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .page-head-image-frame {
    width: 100%;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--canvas-dark);
    border-radius: 2px;
  }
  .page-head-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .page-head-caption {
    margin-top: 14px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
  }
  @media (min-width: 960px) {
    .page-head-grid { grid-template-columns: 1.1fr 1fr; gap: 64px; }
  }

  /* ---------- WHY CUSTOM (matches service-areas city-services numbered list) ---------- */
  .why {
    padding: 80px 0;
    background: var(--canvas);
  }
  .why-head { margin-bottom: 36px; }
  .why h2 {
    font-size: clamp(30px, 4vw, 52px);
    letter-spacing: -0.03em;
    margin-top: 14px;
    max-width: 24ch;
    text-wrap: balance;
  }
  .why-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .why-list li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 18px;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule-strong);
    align-items: baseline;
  }
  .why-num {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--rust);
  }
  .why-text {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 62ch;
  }
  .why-text strong { color: var(--charcoal); font-weight: 600; }

  /* ---------- PRICING (exact reuse of services.astro price-list component) ---------- */
  .cat {
    padding: 72px 0;
    background: var(--canvas-light);
    border-top: 1px solid var(--rule-strong);
  }
  .cat-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .cat-num {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .cat h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .price-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .price-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule-strong);
    align-items: baseline;
  }
  .pi-name {
    font-family: var(--f-serif);
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--charcoal);
    max-width: 46ch;
  }
  .pi-price {
    font-family: var(--f-mono);
    font-size: clamp(14px, 1.6vw, 15px);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--charcoal);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .cat-foot {
    margin: 24px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 60ch;
  }

  /* ---------- HOW IT WORKS (exact reuse of services.astro how-grid component) ---------- */
  .how {
    padding: 88px 0 100px;
    background: var(--canvas);
    border-top: 2px solid var(--charcoal);
  }
  .how h2 {
    font-size: clamp(32px, 4.4vw, 52px);
    letter-spacing: -0.03em;
    margin: 0 auto 36px;
    max-width: 14ch;
    text-align: center;
  }
  .how-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }
  .how-card {
    padding: 32px 16px;
    border-bottom: 1px solid var(--rule-strong);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }
  .how-card:last-child { border-bottom: none; }
  .how-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--river);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: var(--canvas-light);
    flex-shrink: 0;
  }
  .how-icon svg { width: 22px; height: 22px; }
  .how-card h4 {
    font-family: var(--f-serif);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--charcoal);
  }
  .how-card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 42ch;
  }

  /* ---------- GALLERY (exact reuse of portfolio/index.astro portfolio-grid component) ---------- */
  .gallery {
    padding: 88px 0;
    background: var(--canvas-light);
    border-top: 2px solid var(--charcoal);
  }
  .gallery-head { max-width: 64ch; margin-bottom: 44px; }
  .gallery h2 {
    font-size: clamp(30px, 4vw, 52px);
    letter-spacing: -0.03em;
    margin-top: 14px;
    text-wrap: balance;
  }
  .gallery h2 em { font-style: italic; color: var(--river); font-weight: 400; }
  .gallery-intro {
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }
  .gallery-empty {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 56ch;
    padding: 28px 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }
  .portfolio-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px 28px;
  }
  .portfolio-card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .card-media {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--canvas-dark);
    border-radius: 2px;
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .card-media-empty {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(45deg, #c9b590 0 14px, #d4c3a0 14px 28px);
  }
  .portfolio-card a:hover .card-media img { transform: scale(1.03); }
  .card-body { padding: 18px 2px 4px; }
  .card-category {
    display: block;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 10px;
  }
  .card-title {
    font-family: var(--f-serif);
    font-weight: 600;
    font-size: clamp(22px, 2.6vw, 28px);
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    color: var(--charcoal);
    text-wrap: balance;
  }
  .card-arrow {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--charcoal);
    border-bottom: 1px solid var(--charcoal);
    padding-bottom: 2px;
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .portfolio-card a:hover .card-arrow { color: var(--rust); border-bottom-color: var(--rust); }
  .gallery-cta { margin-top: 44px; }

  /* ---------- CTA (exact reuse of service-areas city-cta component) ---------- */
  .city-cta {
    padding: 110px 0;
    background: var(--charcoal);
    color: var(--canvas);
  }
  .city-cta :global(.section-num) { color: #b0a99f; }
  .city-cta-inner { max-width: 820px; }
  .city-cta h2 {
    color: var(--canvas);
    font-size: clamp(36px, 5.4vw, 72px);
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 18px 0 24px;
    max-width: 28ch;
    text-wrap: balance;
  }
  .city-cta h2 em { font-style: italic; color: var(--rust); font-weight: 400; }
  .city-cta p {
    font-size: 18px;
    line-height: 1.55;
    max-width: 56ch;
    margin: 0 0 32px;
    color: #d9c9a8;
  }
  .city-cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .city-cta :global(.btn) {
    background: var(--canvas);
    color: var(--charcoal);
    border-color: var(--canvas);
  }
  .city-cta :global(.btn:hover) { background: #fff; color: var(--charcoal); }
  .city-cta :global(.btn-secondary) {
    background: transparent;
    color: var(--canvas);
    border-color: var(--canvas);
  }
  .city-cta :global(.btn-secondary:hover) {
    background: var(--canvas);
    color: var(--charcoal);
  }
  .city-cta-small {
    margin-top: 28px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b0a99f;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (min-width: 640px) {
    .how-grid { grid-template-columns: repeat(2, 1fr); gap: 0; }
    .how-card { padding: 36px 16px; }
    .how-card:nth-last-child(-n+2) { border-bottom: none; }
    .why-list { grid-template-columns: repeat(2, 1fr); }
    .why-list li:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (min-width: 720px) {
    .portfolio-grid { grid-template-columns: repeat(2, 1fr); gap: 64px 48px; }
  }
  @media (min-width: 960px) {
    .how h2 { margin-left: 0; margin-right: 0; text-align: left; }
    .how-grid { grid-template-columns: repeat(4, 1fr); }
    .how-card {
      align-items: flex-start;
      text-align: left;
      gap: 18px;
      padding: 36px 24px 36px 0;
      border-right: 1px solid var(--rule-strong);
      border-bottom: none;
    }
    .how-card:not(:first-child) { padding-left: 24px; }
    .how-card:last-child { border-right: none; padding-right: 0; }
  }
  @media (min-width: 1100px) {
    .portfolio-grid { gap: 80px 56px; }
  }
  @media (max-width: 639px) {
    .pi-name { font-size: 16px; }
    .pi-price { font-size: 13px; }
    .price-item { gap: 14px; }
  }
</style>
