  .hero-lower[data-seam]::before { top: -6px; }
  :global(.js) .hero-lower[data-seam]::before { transition-delay: 0.9s; }

  /* TRUST — the four items arrive one after another. */
  :global(.js) .trust-list li {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(0.25s + var(--i, 0) * 0.11s);
  }
  :global(.js) .trust-grid.is-visible .trust-list li { opacity: 1; transform: none; }

  /* A stitched spine down the list, sewn top to bottom as the items arrive;
     each number is a knot on it. */
  .trust-list { position: relative; }
  .trust-list::before {
    content: '';
    position: absolute;
    left: 12px;
    top: 30px;
    bottom: 30px;
    width: 2px;
