  /* Hidden-until-revealed only when scripts run; without JS everything shows. */
  :global(.js) [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
