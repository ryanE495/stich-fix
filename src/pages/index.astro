</style>

<script>
  // Sections fade up, and seams sew in, as they come into view.
  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal], [data-seam]');
  if (reveals.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -10% 0px' }
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-visible'));
  }

  // The shop: once the photo is sewn on (SewnPhoto fires "sewn"), embroider
  // the signature. Markup defaults to the finished state; only when motion is
  // allowed do we unstitch it up front.
  const sewSection = document.querySelector<HTMLElement>('[data-sew-on]');
  const motionOK = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (sewSection && motionOK && 'IntersectionObserver' in window) {
    const sigReveal = sewSection.querySelector('.sig-reveal');
    const signature = sewSection.querySelector('.signature');
    sigReveal?.setAttribute('stroke-dashoffset', '160');
    signature?.classList.add('sig-pending');
    sewSection.addEventListener(
      'sewn',
      () => {
        sewSection.querySelectorAll<SVGAnimationElement>('[data-sig-anim]').forEach((a) => a.beginElement());
        window.setTimeout(() => signature?.classList.remove('sig-pending'), 1400);
      },
      { once: true },
    );
  }


</script>
