  .m-needle path { fill: none; stroke: var(--charcoal); stroke-linecap: round; }
  .m-needle-bar { stroke-width: 2.4; }
  .m-needle-tip { stroke-width: 1.4; }
  .m-reveal > *,
  .m-reveal-thread { fill: none; stroke: #fff; stroke-width: 8; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .m-wheel { transform-box: fill-box; transform-origin: center; }

  /* Sewn in when the section arrives (scripts only; otherwise it's just drawn). */
  :global(.js) .m-reveal > * { transition: stroke-dashoffset 1.6s cubic-bezier(0.65, 0, 0.35, 1) 0.35s; }
  :global(.js) .m-reveal-thread { transition: stroke-dashoffset 0.9s cubic-bezier(0.65, 0, 0.35, 1) 1.8s; }
  :global(.js) .m-needle { transition: opacity 0.4s ease 1.6s; }
  :global(.js) .trust-grid:not(.is-visible) .m-reveal > *,
