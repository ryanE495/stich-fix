---
import PortfolioPhoto from '../components/PortfolioPhoto.astro';
import PlateSwap from '../components/PlateSwap.astro';
import BeforePrints from '../components/BeforePrints.astro';
import SewnPhoto from '../components/SewnPhoto.astro';
import SewnCards from '../components/SewnCards.astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { site, seo } from '../config/site';
import { fetchPublishedPortfolio, fetchRecentPortfolio, withSlugs } from '../lib/portfolio';
import AreasServed from '../components/AreasServed.astro';
import MailInCallout from '../components/MailInCallout.astro';

// Hero plate: Ryan's pick for the strongest before/after in the portfolio.
const PORTFOLIO_IMAGES = 'https://bswmrfxdadcmuyhmsagv.supabase.co/storage/v1/object/public/stitchworks-portfolio-images';
const heroJob = {
  before: `${PORTFOLIO_IMAGES}/before/1783118573558-6fvd60.jpg`,
  after: `${PORTFOLIO_IMAGES}/after/1783118577655-jl8ou7.jpg`,
  alt: 'canvas wall tent with a new window flap, stove pipe outlet, and ridge pole sleeves',
  href: '/portfolio/wall-tent-restoration-window-flap-stove-pipe-ridge-pole-sleeves/',
};
const personalImage = 'https://bswmrfxdadcmuyhmsagv.supabase.co/storage/v1/object/public/portfolio-images/about-ryan-sewing.webp';

const recentPortfolio = withSlugs(await fetchRecentPortfolio(3));

// One real job per service card, chosen by eye from the portfolio for range:
// outdoor gear, powersports upholstery, and shop upholstery. A job that's
// unpublished or renamed just leaves its card without a photo.
const portfolio = withSlugs(await fetchPublishedPortfolio());
const cardPhoto = (slug: string) => {
  const job = portfolio.find((p) => p.slug === slug);
  return job?.after_image_url ? { src: job.after_image_url, alt: job.title } : null;
};
const serviceCardPhotos = {
  outdoor: cardPhoto('canvas-tipi-repair-multi-tear-restoration'),
  raft: cardPhoto('nrs-raft-bag-zipper-replacement'),
  commercial: cardPhoto('antique-chair-seat-rebuild-with-new-foam-welt-cord'),
};
for (const [card, photo] of Object.entries(serviceCardPhotos)) {
  if (!photo) console.warn(`[home] no portfolio photo found for the ${card} service card`);
}

// "Almost trash": the most beat-up before photos in the portfolio, fanned out
// as prints beside the closing call to action. Each links to how it turned out.
// Order sets position: top-left, top-right, then front and center (on top) —
// so the most beat-up shot, the ATV seat, goes last.
const almostTrash = [
  { slug: 'canvas-tipi-repair-multi-tear-restoration', label: 'Canvas tipi' },
  { slug: 'snowmobile-2-seater-seat-full-rebuild-with-multi-panel-pattern-work', label: 'Snowmobile seat' },
  { slug: 'atv-seat-re-upholstery-full-restoration-from-bare-foam', label: 'ATV seat' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': seo.businessId,
  name: site.name,
  alternateName: 'WSS',
  description: "Heavy-duty gear, canvas, and upholstery repair on Colorado's Western Slope. Industrial sewing for outfitters, guides, hunters, rafters, and commercial accounts.",
  url: `${site.url}/`,
  telephone: seo.telephoneE164,
  priceRange: '$$',
  image: seo.ogImage,
  logo: seo.logoImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Delta',
    addressRegion: 'CO',
    postalCode: seo.postalCode,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: seo.geo.latitude,
    longitude: seo.geo.longitude,
  },
  areaServed: [
    { '@type': 'City', name: 'Montrose, CO' },
    { '@type': 'City', name: 'Delta, CO' },
    { '@type': 'City', name: 'Grand Junction, CO' },
    { '@type': 'City', name: 'Ridgway, CO' },
    { '@type': 'City', name: 'Ouray, CO' },
    { '@type': 'City', name: 'Telluride, CO' },
    { '@type': 'AdministrativeArea', name: 'Western Slope, Colorado' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '18:00',
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Repair Services',
    itemListElement: [
      {
        '@type': 'OfferCatalog',
        name: 'Outdoor & Expedition Gear',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Tipi and wall tent repair' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Strap and webbing repair' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Drybag repair' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Sleeping bag zipper replacement' } },
        ],
      },
      {
        '@type': 'OfferCatalog',
        name: 'Raft, Boat & Powersports',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Raft frame bag repair' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'UTV and side-by-side seat re-upholstery' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Snowmobile seat re-cover' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Boat seat and bimini repair' } },
        ],
      },
      {
        '@type': 'OfferCatalog',
        name: 'Commercial & Upholstery',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Gym equipment re-upholstery' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Restaurant booth and bar stool re-cover' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Commercial awning and canvas repair' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Firehouse gear repair' } },
        ],
      },
    ],
  },
  sameAs: [],
};
---

<Layout
  active="home"
  title="Canvas, Tent & Gear Repair – Delta, CO | Stitchworks"
  description="Wall tents, tipis, tarps, and seats repaired on the Western Slope. Text a photo for a quote in 24 hrs. Pickup across the Western Slope."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="hero" data-screen-label="01 Hero">
    <div class="wrap">
      <div class="hero-meta" data-hero-in style="--hero-delay: 0.05s">
        <span>Repair shop №001</span>
        <span class="dot"></span>
        <span>{site.location.replace(', CO', ' · Colorado')}</span>
        <span class="dot"></span>
        <span>Est. On The Western Slope</span>
      </div>
      <h1 data-hero-in style="--hero-delay: 0.18s">Canvas &amp; heavy-duty gear repair <em>on the Western Slope.</em></h1>
      <div class="hero-lower" data-hero-in data-seam style="--hero-delay: 0.34s">
        <div>
          <p class="hero-sub">
            <a href="/services/canvas-tent-repair/">Wall tents and tipis</a>, rafts, UTV seats, commercial canvas — if it's stitched and you broke it, I can probably fix it. Based in Delta. Serving Montrose, Grand Junction, Ouray, Telluride, and everywhere in between.
          </p>
          <div class="hero-ctas">
            <a href={site.phoneHref} class="btn">Call or Text&nbsp;&nbsp;→&nbsp;{site.phoneDisplay}</a>
            <a href="/contact/" class="btn btn-secondary">Send a photo of the damage →</a>
          </div>
        </div>
        <PlateSwap
          before={heroJob.before}
          after={heroJob.after}
          alt={heroJob.alt}
          caption="Plate 01 / Wall tent, before & after"
          captionHref={heroJob.href}
          location={site.location}
          sizes="(max-width: 720px) 100vw, (max-width: 1180px) 45vw, 540px"
        />
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee">
    <div class="marquee-track">
      <div class="marquee-group">
        <span>Tipi patches</span><span class="sep">✦</span>
        <span>Wall tents</span><span class="sep">✦</span>
                <span>Frame bags</span><span class="sep">✦</span>
        <span>UTV seats</span><span class="sep">✦</span>
        <span>Dry bags</span><span class="sep">✦</span>
        <span>Awnings</span><span class="sep">✦</span>
        <span>Gym pads</span><span class="sep">✦</span>
        <span>Bimini tops</span><span class="sep">✦</span>
        <span>Turnout bags</span><span class="sep">✦</span>
        <span>Canvas, webbing, heavy vinyl</span><span class="sep">✦</span>
      </div>
      <div class="marquee-group" aria-hidden="true">
        <span>Tipi patches</span><span class="sep">✦</span>
        <span>Wall tents</span><span class="sep">✦</span>
                <span>Frame bags</span><span class="sep">✦</span>
        <span>UTV seats</span><span class="sep">✦</span>
        <span>Dry bags</span><span class="sep">✦</span>
        <span>Awnings</span><span class="sep">✦</span>
        <span>Gym pads</span><span class="sep">✦</span>
        <span>Bimini tops</span><span class="sep">✦</span>
        <span>Turnout bags</span><span class="sep">✦</span>
        <span>Canvas, webbing, heavy vinyl</span><span class="sep">✦</span>
      </div>
    </div>
  </div>

  <!-- SERVICE AREA STRIP -->
  <AreasServed map />

  <!-- PERSONAL -->
  <section class="personal" data-screen-label="02 Personal">
    <div class="wrap">
      <div class="personal-grid" data-reveal data-sew-on>
        <div>
          {/* The photo is sewn on like a patch (SewnPhoto); the signature is
              embroidered once it fires "sewn" — see the script below. */}
          <div class="personal-photo-wrap">
            <SewnPhoto id="ryan-photo" width={320} height={400}>
              <div class="personal-photo-frame">
                <Image
                  class="personal-photo"
                  src={personalImage}
                  width={640}
                  height={800}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 900px) 280px, 320px"
                  format="webp"
                  quality={82}
                  alt="Ryan, the owner of Western Slope Stitchworks"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </SewnPhoto>
          </div>
          <div class="personal-photo-tag">Ryan, Proprietor · Plate 02</div>
        </div>
        <div class="personal-body">
          <div class="section-num">§ 02 — The Shop</div>
          <h2 style="margin-top:16px">I'm Ryan. I run the shop. <em>Every stitch comes through me.</em></h2>
          <p>I run Western Slope Stitchworks out of Delta. I've been sewing for years, working on everything from outfitter canvas to UTV seats to shop upholstery.</p>
          <p>I'm a fisherman, a hunter, and a jiu-jitsu guy, so I know what gear gets beat up and how it needs to come back. Fast turnaround, honest pricing, no upsell.</p>
          {/* Signature embroidered after the patch: a running-stitch outline
              of the letters, then the ink fills in. The real text stays in the
              page for screen readers and search; the SVG is decorative. */}
          <div class="signature">
            <span class="sig-text">Ryan</span>
            <svg class="sig-svg" viewBox="0 0 120 50" aria-hidden="true" focusable="false">
              <defs>
                <mask id="sig-mask" maskUnits="userSpaceOnUse">
                  <text class="sig-reveal" x="3" y="38" stroke-dashoffset="0">Ryan
                    <animate data-sig-anim attributeName="stroke-dashoffset" from="160" to="0" dur="1.6s" begin="indefinite" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines="0.45 0 0.55 1" />
                  </text>
                </mask>
              </defs>
              <text class="sig-fill" x="3" y="38">Ryan</text>
              <text class="sig-stitch" x="3" y="38" mask="url(#sig-mask)">Ryan</text>
            </svg>
          </div>
          <div class="signature-line">— Proprietor · One-person shop</div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services" data-seam data-screen-label="03 Services">
    <div class="wrap">
      <div class="services-head" data-reveal>
        <div>
          <div class="section-num">§ 03 — What I Fix</div>
          <h2 style="margin-top:16px">Three workbenches. One sewing machine. Everything you've torn up.</h2>
        </div>
        <div class="services-head-right">
          If your gear isn't listed below, ask anyway. I've probably either done it, or I know the guy who can.
        </div>
      </div>
      <div class="service-cards" data-reveal style="--reveal-delay: 140ms">
        <a class="service-card" href="/services#outdoor">
          <div class="service-media" aria-hidden="true">{serviceCardPhotos.outdoor && <PortfolioPhoto src={serviceCardPhotos.outdoor.src} alt="" sizes="(max-width: 900px) 100vw, (max-width: 1180px) 33vw, 393px" />}</div>
          <div class="service-num">01 / Outdoor &amp; Expedition</div>
          <h3>Outdoor &amp; Expedition Gear</h3>
          <p>Tipis, wall tents, hot tents, dry bags, tarps, bivys, sleeping bag zippers, and webbing.</p>
          <div class="service-tags">
            <span class="service-tag">Tipis</span>
                        <span class="service-tag">Zippers</span>
            <span class="service-tag">Dry bags</span>
            <span class="service-tag">Tarps</span>
          </div>
          <span class="service-link">See pricing →</span>
        </a>
        <a class="service-card" href="/services#raft">
          <div class="service-media" aria-hidden="true">{serviceCardPhotos.raft && <PortfolioPhoto src={serviceCardPhotos.raft.src} alt="" sizes="(max-width: 900px) 100vw, (max-width: 1180px) 33vw, 393px" />}</div>
          <div class="service-num">02 / Raft, Boat &amp; Powersports</div>
          <h3>Raft, Boat &amp; Powersports</h3>
          <p>Frame bags, straps, raft patches, dry bags, UTV and snowmobile seats, boat covers, bimini tops.</p>
          <div class="service-tags">
            <span class="service-tag">Frame bags</span>
            <span class="service-tag">Straps</span>
            <span class="service-tag">UTV seats</span>
            <span class="service-tag">Biminis</span>
          </div>
          <span class="service-link">See pricing →</span>
        </a>
        <a class="service-card" href="/services#commercial">
          <div class="service-media" aria-hidden="true">{serviceCardPhotos.commercial && <PortfolioPhoto src={serviceCardPhotos.commercial.src} alt="" sizes="(max-width: 900px) 100vw, (max-width: 1180px) 33vw, 393px" />}</div>
          <div class="service-num">03 / Commercial &amp; Custom</div>
          <h3>Commercial &amp; Custom Work</h3>
          <p>Gym equipment re-upholstery, restaurant booths, church kneelers and banners, awnings, firehouse gear, custom stitch jobs.</p>
          <div class="service-tags">
            <span class="service-tag">Gym pads</span>
            <span class="service-tag">Booths</span>
            <span class="service-tag">Awnings</span>
            <span class="service-tag">Turnout</span>
          </div>
          <span class="service-link">See pricing →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- RECENT WORK -->
  <section class="recent-work" data-seam>
    <div class="wrap">
      <div class="recent-head" data-reveal>
        <div>
          <div class="section-num">§ Recent Work</div>
          <h2>A look at what's <em>come through the shop.</em></h2>
        </div>
        <a class="recent-cta" href="/portfolio/">See the full portfolio &rarr;</a>
      </div>
      {recentPortfolio.length > 0 ? (
        <SewnCards items={recentPortfolio} data-reveal style="--reveal-delay: 120ms" />
      ) : (
        <p class="recent-empty" data-reveal>
          Fresh repairs and custom builds go up regularly. <a href="/portfolio/">Browse the portfolio &rarr;</a>
        </p>
      )}
    </div>
  </section>

  <!-- CUSTOM BUILDS CALLOUT -->
  <section class="custom-callout">
    <div class="wrap">
      <a class="custom-callout-link" href="/custom-builds/" data-reveal>
        <div class="cco-text">
          <span class="cco-kicker">§ Custom Work</span>
          <h2>Bring me your <em>weird</em> projects.</h2>
          <p>RV awning mods, sleeping bag conversions, custom bags, hunting gear customization, one-off industrial sewing. Most repair shops won&rsquo;t take it on. I will.</p>
          <span class="cco-cta">See custom builds &amp; modifications &rarr;</span>
        </div>
        <div class="cco-arrow" aria-hidden="true">→</div>
      </a>
    </div>
  </section>

  <!-- TRUST -->
  <section class="trust" data-screen-label="04 Trust">
    <div class="wrap">
      <div class="trust-grid" data-reveal>
        <div>
          <div class="section-num">§ 04 — How I Work</div>
          <h2 style="margin-top:16px">No middleman. No outsourcing. <em>Just the work.</em></h2>
          {/* A stitched industrial machine: its outline sews in, the thread
              runs spool to needle, then it runs for a moment (needle bobs,
              handwheel turns, fabric feeds). Hover runs it again. Moving parts
              sit outside the reveal mask so they never get clipped. */}
          <figure class="machine" aria-hidden="true">
            <svg viewBox="0 0 320 190" focusable="false">
              <defs>
                <mask id="machine-body-mask" maskUnits="userSpaceOnUse">
                  <g class="m-reveal">
                    <path pathLength="1" d="M8 172 H312" />
                    <path pathLength="1" d="M36 172 V156 Q36 151 41 151 H269 Q274 151 274 156 V172" />
                    <path pathLength="1" d="M226 151 V86 H104 V118 Q104 126 96 126 H66 Q58 126 58 118 V54 Q58 46 66 46 H252 Q264 46 264 58 V151" />
                    <circle pathLength="1" cx="282" cy="72" r="21" />
                    <circle pathLength="1" cx="282" cy="72" r="5" />
                    <path pathLength="1" d="M196 46 V32 M185 14 H207 M185 32 H207 M189 14 V32 M203 14 V32" />
                    <path pathLength="1" d="M90 126 V145 M74 148 H94" />
                    <path pathLength="1" d="M44 150 H140" />
                  </g>
                </mask>
                <mask id="machine-thread-mask" maskUnits="userSpaceOnUse">
                  <path class="m-reveal-thread" pathLength="1" d="M196 13 C 168 -2, 108 -2, 84 32 Q 76 42 76 56 V118 Q 76 132 80 141" />
                </mask>
              </defs>
              <g class="m-body" mask="url(#machine-body-mask)">
                <path d="M8 172 H312" />
                <path d="M36 172 V156 Q36 151 41 151 H269 Q274 151 274 156 V172" />
                <path d="M226 151 V86 H104 V118 Q104 126 96 126 H66 Q58 126 58 118 V54 Q58 46 66 46 H252 Q264 46 264 58 V151" />
                <g class="m-wheel">
                  <circle cx="282" cy="72" r="21" />
                  <circle cx="282" cy="72" r="5" />
                </g>
                <path d="M196 46 V32 M185 14 H207 M185 32 H207 M189 14 V32 M203 14 V32" />
                <path d="M90 126 V145 M74 148 H94" />
                <path class="m-fabric" d="M44 150 H140" />
              </g>
              <path class="m-thread" mask="url(#machine-thread-mask)" d="M196 13 C 168 -2, 108 -2, 84 32 Q 76 42 76 56 V118 Q 76 132 80 141" />
              <g class="m-needle">
                <path class="m-needle-bar" d="M80 126 V140" />
                <path class="m-needle-tip" d="M80 140 V148" />
              </g>
            </svg>
          </figure>
        </div>
        <ul class="trust-list">
          <li style="--i: 0">
            <span class="num">01</span>
            <span class="body"><strong>Industrial machine setup</strong>Handles canvas, webbing, and heavy vinyl — up to about four layers.</span>
          </li>
          <li style="--i: 1">
            <span class="num">02</span>
            <span class="body"><strong>3–7 day turnaround</strong>Most repairs go out the door inside a week. Rush work available — just ask.</span>
          </li>
          <li style="--i: 2">
            <span class="num">03</span>
            <span class="body"><strong>Local pickup &amp; drop-off</strong>Free in Montrose, Olathe &amp; Delta. Everywhere else on the Western Slope for a small route fee.</span>
          </li>
          <li style="--i: 3">
            <span class="num">04</span>
            <span class="body"><strong>Free estimates</strong>Text a photo. I'll tell you if it's worth repairing and what it'll cost. No charge to ask.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- MAIL-IN (national) — link only; keeps the homepage's local targeting intact -->
  <MailInCallout />

  <!-- WHO -->
  <section class="who" data-screen-label="05 Who">
    <div class="wrap">
      <h2 data-reveal>Outfitters. Guide companies. Hunters. Raft outfits. Fire departments. Gyms. Churches. Ranches. <em>If you use it hard, I can fix it.</em></h2>
      <div class="who-row" data-reveal style="--reveal-delay: 140ms">
        <div class="who-cell">Outfitters</div>
        <div class="who-cell">Guide Cos.</div>
        <div class="who-cell">Hunters</div>
        <div class="who-cell">Raft Outfits</div>
        <div class="who-cell">Fire Depts.</div>
        <div class="who-cell">Gyms</div>
        <div class="who-cell">Churches</div>
        <div class="who-cell">Ranches</div>
      </div>
      <span class="who-tag" data-reveal style="--reveal-delay: 260ms">— Referrals &amp; commercial accounts welcome —</span>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final" data-seam data-screen-label="06 CTA">
    <div class="wrap">
      <div class="final-grid">
        <div class="final-inner" data-reveal>
          <div class="section-num">§ 06 — Ask First</div>
          <h2 style="margin-top:22px">Torn, blown out, or <em>"almost trash"</em>?<br/>Send me a photo.</h2>
          <p>I'll tell you if it's worth repairing and what it'll cost. No charge to ask, no runaround. Just text me the photos.</p>
          <div class="final-ctas">
            <a href={site.phoneHref} class="btn">Call or Text {site.phoneDisplay}</a>
            <a href="/contact/" class="btn btn-secondary">Use the contact form →</a>
          </div>
          <div class="final-small">{site.hours} · {site.location}</div>
        </div>
        <BeforePrints jobs={almostTrash} startPlate={3} data-reveal style="--reveal-delay: 160ms" />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ========== HOME — scoped to index ========== */
  .hero { padding: 64px 0 96px; position: relative; }
  .hero-meta {
    display: flex; align-items: center; gap: 18px;
    font-family: var(--f-mono); font-size: 11px;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 44px; flex-wrap: wrap;
  }
  .hero-meta .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--rust); }
  .hero h1 {
    font-size: clamp(52px, 8.2vw, 124px);
    letter-spacing: -0.04em; font-weight: 600;
    line-height: 0.94; max-width: 14ch; text-wrap: balance;
  }
  .hero h1 em { font-style: italic; font-weight: 400; color: var(--river); display: block; }
  .hero-lower {
    margin-top: 56px; display: grid;
    grid-template-columns: 1.1fr 1fr; gap: 64px;
    align-items: start; padding-top: 40px;
    border-top: 1px solid var(--rule-strong);
  }
  .hero-sub { margin: 0; font-size: 19px; line-height: 1.55; max-width: 46ch; color: var(--ink); }
  .hero-sub a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--rule-strong); }
  .hero-sub a:hover { color: var(--rust); border-bottom-color: var(--rust); }
  .hero-ctas { margin-top: 28px; display: flex; gap: 14px; flex-wrap: wrap; }

  .marquee {
    background: var(--charcoal); color: var(--canvas);
    padding: 20px 0; overflow: hidden;
    font-family: var(--f-serif); font-style: italic;
