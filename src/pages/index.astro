    :global(.js) .m-needle { opacity: 1 !important; transition: none; }
    .m-needle, .m-wheel, .m-fabric,
    .machine:hover .m-needle, .machine:hover .m-wheel, .machine:hover .m-fabric { animation: none !important; }
    .service-media img,
