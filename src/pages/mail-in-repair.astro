---
import Layout from '../layouts/Layout.astro';
import { site, seo } from '../config/site';
import { mailIn, mailInShipping } from '../config/mail-in';

// Mail-in repair targets NATIONAL ship-in intent ("mail in tent repair",
// "ship canvas tent for repair", "wall tent repair service", "tipi repair",
// "UTV seat recover mail in"). The local service pages own "near me" intent
// for Montrose/Delta — keep every heading and title here qualified with
// mail-in / ship language so the two never compete for the same query.

const canonicalPath = mailIn.path;
const start = mailIn.startHref;
const cta = mailIn.ctaLabel;

const repairs = [
  {
    name: 'Tents and tipis',
    body: 'Wall tent and tipi repair: torn panels, blown seams, broken zippers, stove pipe openings, ridge pole sleeves, and grommets that pulled out. Bell tents and hot tents too.',
  },
  {
    name: 'Sun shades and awnings',
    body: 'Torn fabric, failed hems, and the buckle and grommet points that wind tears loose.',
  },
  {
    name: 'Seats and upholstery',
    body: 'UTV, side-by-side, and snowmobile seat recovers by mail. Pull the seat and ship just the seat. The machine stays home.',
  },
  {
    name: 'Other canvas',
    body: 'Tarps, covers, bags, and banners. If it’s canvas, vinyl, or webbing and it’s under about four layers thick, ask.',
  },
];

const steps = [
  {
    title: 'Fill out the repair request',
    body: 'Tell me what it is, what’s wrong with it, and where you are, with a few photos. The form gives you a rough repair and shipping estimate for your ZIP. It takes a few minutes and doesn’t commit you to anything.',
  },
  {
    title: 'I call you before anything ships',
    body: 'Within one business day, I reach out. We go over your photos and confirm the repair, I give you the real shipping cost, and I walk you through packing it. A lot of the time that call saves you money. Sometimes a repair just isn’t worth the shipping, and you should hear that before you pay to send it, not after.',
  },
  {
    title: 'Get your shipping label',
    body: 'If it makes sense to send, I set up the label for your box after the call and send it to you, along with the packing instructions we talked through.',
  },
  {
    title: 'Ship it',
    body: 'Pack it clean and completely dry, tape the label on, and drop it off with the carrier.',
  },
  {
    title: 'Get a firm quote, with photos',
    body: 'When it arrives I unpack it, photograph the damage, and send you a firm price and a ship-back date. No work starts until you approve it. If you say no, you pay return shipping and that’s it.',
  },
  {
    title: 'Get it back',
    body: 'I repair it, photograph the finished work, and ship it back to you. The repair and return shipping are billed once you’ve approved the quote.',
  },
];

const costRows = [
  { name: 'Mail-in minimum per job', price: `$${mailIn.minimum}` },
  ...mailInShipping,
];

// FAQ answers are arrays of paragraphs (plus optional steps) so the visible
// text and the FAQPage schema text are generated from the same source.
const faqs: { q: string; a: string[]; steps?: string[] }[] = [
  {
    q: 'Does it have to be clean and dry?',
    a: [
      'Yes. This is a hard requirement. Canvas packed damp will mildew in the box, and dirt gets ground into the fabric and the seams.',
      'Set it up or hang it until it’s dry all the way through on both sides, then shake out the dirt and needles before you pack it. If it arrives wet or dirty, I’ll contact you before doing anything else, and return shipping is on you.',
    ],
  },
  {
    q: 'What if it can’t be repaired?',
    a: [
      'Most of the time we catch that on the phone, before you ship anything. If it only shows up once it’s here, I’ll tell you with photos showing why. Your request says whether to ship it back as-is, at your cost, or dispose of it. Either way there’s no repair charge and no minimum.',
    ],
  },
  {
    q: 'Do I ship the frame or poles?',
    a: [
      'No. Send the fabric only. Frames and poles make the box bigger and heavier, which is most of what drives the shipping cost, and I don’t need them to do the repair.',
      'If a pole sleeve or frame pocket is part of the problem, measure the pole diameter and put it in your request.',
    ],
  },
  {
    q: 'Is it insured?',
    a: [
      'A shipping label comes with the carrier’s standard coverage, which is usually $100. That isn’t much against a $2,000 tent.',
      'If yours is worth more, say so on the call and we’ll add declared-value coverage for the full amount before the label goes out. On anything you’d hate to lose, I’d add it. Take a few photos of it before you pack it, too, so you have a record of its condition.',
    ],
  },
  {
    q: 'How do I pack a wall tent?',
    a: ['Here’s what works:'],
    steps: [
      'Make sure it’s completely dry.',
      'Shake out dirt, needles, and anything else caught in the folds.',
      'Leave out the poles, frame, and stove.',
      'Fold it into a flat bundle, then roll it tight.',
      'Put it in a heavy contractor bag to keep weather out.',
      'Use a sturdy box close to the size of the bundle so it can’t shift around.',
      'Tape the label flat on the largest side.',
    ],
  },
  {
    q: 'What if the quote is more than I want to spend?',
    a: [
      'Say no. I’ll ship it back and you pay return shipping, nothing else.',
      'If there’s a smaller repair that fixes the part you care about most, I’ll tell you, and you can decide from there.',
    ],
  },
  {
    q: 'Can I just box it up and send it without the form?',
    a: [
      'Please don’t. Start with the request so I can call you first. We settle the repair, the shipping cost, and the timing before it ships, and when the box shows up I already know whose it is.',
    ],
  },
];

const title = 'Mail-In Tent & Canvas Repair | Western Slope Stitchworks';
const description =
  'Ship your wall tent, tipi, sun shade, or UTV seat in for repair from anywhere in the US. Firm quote with photos before any repair is charged.';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Mail-In Tent & Canvas Repair',
  serviceType: 'Mail-in canvas tent, tipi, awning, and seat upholstery repair',
  description:
    'Nationwide mail-in repair for wall tents, tipis, sun shades, awnings, and UTV and snowmobile seats. Customers send a request, get a phone call to confirm the repair and the real shipping cost before anything ships, receive a firm quote with photos once the item arrives, and are not charged for the repair until they approve it.',
  url: `${site.url}${canonicalPath}`,
  provider: {
    '@type': 'LocalBusiness',
    '@id': seo.businessId,
  },
  areaServed: { '@type': 'Country', name: 'United States' },
  offers: {
    '@type': 'Offer',
    description: `$${mailIn.minimum} minimum per mail-in repair. Shipping is estimated on the request and confirmed by phone before anything ships.`,
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: String(mailIn.minimum),
      priceCurrency: 'USD',
    },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Mail-In Repair',
    itemListElement: repairs.map((r) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: `Mail-in ${r.name.toLowerCase()} repair` },
    })),
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: [...f.a, ...(f.steps ?? [])].join(' '),
    },
  })),
};
---

<Layout
  active="mail-in"
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={[serviceJsonLd, faqJsonLd]}
>
  <!-- HERO -->
  <section class="page-head">
    <div class="wrap">
      <div class="section-num">§ Mail-In Repair · Anywhere in the US</div>
      <h1>Mail-In Tent &amp; <em>Canvas Repair.</em></h1>
      <div class="page-head-grid">
        <div class="page-head-text">
          <p class="page-tagline">Ship it to the shop instead of driving it here. For a lot of people it costs about the same, and it doesn’t cost you a day.</p>
          <div class="page-ctas" id="hero-cta">
            <a href={start} class="btn">{cta} <span class="btn-arrow" aria-hidden="true">&rarr;</span></a>
          </div>
          <p class="cta-note">I call before you ship anything. The repair isn’t charged until you approve a firm quote.</p>
          <p class="page-body">You don’t have to live near Colorado to get your canvas fixed here. Ship your tent in for repair, get photos and a firm price, and decide from there. Questions first? Call or text <a href={site.phoneHref}>{site.phoneDisplay}</a>.</p>
        </div>

        <div class="math" aria-labelledby="math-lead">
          <div class="math-kicker">The math on driving it in</div>
          <p class="math-lead" id="math-lead">One customer drove four hours each way to bring a wall tent to the shop.</p>
          <table class="math-table">
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">Cost</span></th>
                <th scope="col">Drive it in</th>
                <th scope="col">Ship it in</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Your time</th>
                <td>8 hours on the road</td>
                <td>Pack it, drop it off</td>
              </tr>
              <tr>
                <th scope="row">Money</th>
                <td>About $200 in gas</td>
                <td>{mailInShipping[0].price} round trip</td>
              </tr>
            </tbody>
          </table>
          <p class="math-foot">Close to the same money. One of them takes your whole day.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 WHAT I REPAIR -->
  <section class="repairs">
    <div class="wrap">
      <div class="sec-head">
        <div class="section-num">§ 01 — What I Repair</div>
        <h2>What you can ship in <em>for repair.</em></h2>
        <p class="sec-intro">If you’ve been looking for a wall tent repair service you can mail to, this is it. Here’s what comes through by mail.</p>
      </div>
      <ul class="repair-list">
        {repairs.map((r) => (
          <li>
            <h3>{r.name}</h3>
            <p>{r.body}</p>
          </li>
        ))}
      </ul>
      <p class="repairs-foot">Not by mail: frames, poles, and anything wet or dirty. <a href="#questions">More on that below.</a></p>
    </div>
  </section>

  <!-- 02 HOW IT WORKS -->
  <section class="steps">
    <div class="wrap">
      <div class="sec-head">
        <div class="section-num">§ 02 — How It Works</div>
        <h2>How mail-in repair works.</h2>
      </div>
      <ol class="step-list">
        {steps.map((s, i) => (
          <li>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="steps-callout"><strong>Nothing ships until we’ve talked.</strong> And nothing is charged for the repair until you’ve seen the photos and approved the quote.</p>
    </div>
  </section>

  <!-- 03 WHAT IT COSTS -->
  <section class="cost" id="cost">
    <div class="wrap">
      <div class="sec-head">
        <div class="section-num">§ 03 — What It Costs</div>
        <h2>What it costs, <em>shipping included.</em></h2>
        <p class="sec-intro">Shipping is a real part of what a mail-in repair costs, so here it is up front, before you’ve spent a dollar.</p>
      </div>
      <ul class="price-list">
        {costRows.map((row) => (
          <li class="price-item">
            <span class="pi-name">{row.name}</span>
            <span class="pi-price">{row.price}</span>
          </li>
        ))}
      </ul>
      <div class="cost-notes">
        <p>Those shipping ranges are rough. They depend on size, weight, and how far you are from Colorado. The request form gives you an estimate for your ZIP, and I confirm the real shipping cost on the phone before anything ships.</p>
        <p>The repair itself is quoted once I’ve seen it. The mail-in minimum is higher than the local shop minimum because every mail-in job gets unpacked, photographed, and packed back up for the trip home.</p>
        <p class="local-note">Close enough to drive? <a href="/services/">Local drop-off and pickup</a> skips the shipping.</p>
      </div>
    </div>
  </section>

  <!-- 04 TURNAROUND & CAPACITY -->
  <section class="capacity">
    <div class="wrap">
      <div class="capacity-grid">
        <div>
          <div class="section-num">§ 04 — Turnaround</div>
          <h2>Booked by <em>intake week.</em></h2>
          <!-- TODO(Ryan): if you want to state the weekly job cap, set it in config/mail-in.ts and add it here. -->
          <p>I take a set number of mail-in jobs each week and book them by the week they arrive. When a week is full, the next request goes to the next open week.</p>
          <p>That’s deliberate. Every repair goes through one person and one machine. Capping the week is how each job gets a careful look instead of getting squeezed in between others.</p>
          <p>We settle timing on the call, before you ship. Send it for the week we agree on, not before.</p>
        </div>
        <aside class="season">
          <div class="season-kicker">August – September</div>
          <p class="season-head">Wall tent season books out first.</p>
          <p>Those weeks fill early with people getting ready for elk season. If your wall tent needs work before fall, send the request early.</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 05 PROOF -->
  <section class="proof">
    <div class="wrap">
      <div class="sec-head">
        <div class="section-num">§ 05 — The Work</div>
        <h2>Who does <em>the work.</em></h2>
      </div>

      <div class="ba-pairs">
        <!-- TODO(Ryan): replace these placeholders with real before/after repair photos.
             Swap each <div class="ph ..."> for an <Image> (import from 'astro:assets'),
             keep the 4:3 frame, and write alt text that describes the actual repair. -->
        <figure class="ba-pair">
          <div class="ba-row">
            <div class="ba-frame ph" data-label="TODO: Before photo — wall tent"></div>
            <div class="ba-frame ph" data-label="TODO: After photo — wall tent"></div>
          </div>
          <figcaption class="plate"><span>Plate 01 / Wall tent, before &amp; after</span><span>Olathe, CO</span></figcaption>
        </figure>
        <figure class="ba-pair">
          <div class="ba-row">
            <div class="ba-frame ph" data-label="TODO: Before photo — seat or sun shade"></div>
            <div class="ba-frame ph" data-label="TODO: After photo — seat or sun shade"></div>
          </div>
          <figcaption class="plate"><span>Plate 02 / Seat or shade, before &amp; after</span><span>Olathe, CO</span></figcaption>
        </figure>
      </div>

      <div class="bio">
        <div class="bio-photo">
          <!-- TODO(Ryan): replace with a real photo of you in the shop. -->
          <div class="bio-frame ph" data-label="TODO: Photo of Ryan in the shop"></div>
          <div class="plate"><span>Plate 03 / The shop</span><span>Olathe, CO</span></div>
        </div>
        <div class="bio-text">
          <h3>I’m Ryan.</h3>
          <p>I taught myself to sew. My industrial sewing background comes from Colorado Yurt Company, which builds canvas yurts and tipis.</p>
          <p>The shop is in {mailIn.shopLocation}. It’s a one-person shop. Nobody else touches your gear, and I’m the one who answers when you call.</p>
          <p>Before you send me anything, look at the work. <a href="/portfolio/">See before-and-after repairs in the portfolio &rarr;</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 FAQ -->
  <section class="faq" id="questions">
    <div class="wrap">
      <div class="sec-head">
        <div class="section-num">§ 06 — Questions</div>
        <h2>Mail-in repair <em>questions.</em></h2>
      </div>
      <ul class="faq-list">
        {faqs.map((f) => (
          <li class="faq-item">
            <h3 class="faq-q">{f.q}</h3>
            {f.a.map((p) => <p class="faq-a">{p}</p>)}
            {f.steps && (
              <ol class="faq-steps">
                {f.steps.map((s) => <li>{s}</li>)}
              </ol>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="city-cta" id="final-cta">
    <div class="wrap">
      <div class="city-cta-inner">
        <div class="section-num">§ Next Step</div>
        <h2>Start with the request. <em>I’ll call before anything ships.</em></h2>
        <p>Tell me what it is and where you are, and I’ll reach out within one business day. You’ll hear the real shipping cost, and whether the repair is even worth it, before you pay to send anything.</p>
        <div class="city-cta-row">
          <a href={start} class="btn">{cta} <span class="btn-arrow" aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="city-cta-small">${mailIn.minimum} mail-in minimum &middot; Shop in Olathe, Colorado &middot; <a href={site.phoneHref}>Call or text {site.phoneDisplay}</a></div>
      </div>
    </div>
  </section>

  <!-- STICKY MOBILE CTA — shown after the hero CTA scrolls away, hidden once the closing CTA is reached. -->
  <div class="sticky-cta" aria-hidden="true">
    <a href={start} class="btn" tabindex="-1">{cta} <span class="btn-arrow" aria-hidden="true">&rarr;</span></a>
  </div>
</Layout>

<style>
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ---------- HERO (matches sun-shades / service page-head) ---------- */
  .page-head {
    padding: 48px 0 64px;
    background: var(--canvas-light);
    border-bottom: 2px solid var(--charcoal);
  }
  /* Capped smaller than other pages' 124px heroes so the driving math — the
     lead argument — stays above the fold on a typical laptop screen. */
  .page-head h1 {
    font-size: clamp(46px, 7vw, 96px);
    line-height: 0.94;
    letter-spacing: -0.04em;
    font-weight: 600;
    margin-top: 18px;
    max-width: 16ch;
    text-wrap: balance;
  }
  .page-head h1 em { font-style: italic; font-weight: 400; color: var(--river); }
  .page-head-grid {
    margin-top: 40px;
    padding-top: 36px;
    border-top: 1px solid var(--rule-strong);
    display: grid;
    grid-template-columns: 1fr;
    gap: 44px;
    align-items: start;
  }
  .page-tagline {
    margin: 0;
    font-size: 21px;
    line-height: 1.45;
    max-width: 44ch;
    color: var(--ink);
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 500;
  }
  .page-ctas {
    margin-top: 28px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .cta-note {
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 48ch;
  }
  .page-body {
    margin: 26px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--rule-strong);
    font-size: 16px;
    line-height: 1.6;
    max-width: 54ch;
    color: var(--ink);
  }
  .page-body a { color: var(--charcoal); font-weight: 600; }

  /* The driving math — a ledger, not a feature card. */
  .math {
    background: var(--canvas);
    border: 1px solid var(--rule-strong);
    border-top: 3px solid var(--charcoal);
    padding: 26px 26px 22px;
  }
  .math-kicker {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .math-lead {
    margin: 10px 0 16px;
    font-family: var(--f-serif);
    font-weight: 600;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--charcoal);
  }
  .math-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .math-table th,
  .math-table td {
    text-align: left;
    vertical-align: top;
    padding: 10px 10px 10px 0;
    border-top: 1px solid var(--rule-strong);
  }
  .math-table thead th {
    border-top: none;
    padding-top: 0;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .math-table thead th:first-child { width: 26%; }
  .math-table tbody th {
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 15px;
  }
  .math-table td {
    font-family: var(--f-serif);
    font-size: 18px;
    line-height: 1.3;
    font-weight: 500;
    color: var(--charcoal);
  }
  .math-table td:last-child { color: var(--river); }
  .math-foot {
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--rule-strong);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
  }

  @media (min-width: 960px) {
    .page-head-grid { grid-template-columns: 1.05fr 1fr; gap: 64px; }
  }
  @media (max-width: 639px) {
    .page-head { padding: 40px 0 48px; }
    .page-head-grid { margin-top: 28px; padding-top: 24px; gap: 36px; }
    .page-tagline { font-size: 19px; }
    .page-ctas .btn { width: 100%; justify-content: center; }
    .math { padding: 22px 18px 18px; }
    .math-table td { font-size: 16px; }
  }

  /* ---------- Shared section heads ---------- */
  .sec-head { max-width: 64ch; margin-bottom: 40px; }
  .sec-head h2 {
    font-size: clamp(32px, 4.2vw, 54px);
    letter-spacing: -0.03em;
    margin-top: 14px;
    text-wrap: balance;
  }
  .sec-head h2 em { font-style: italic; font-weight: 400; color: var(--river); }
  .sec-intro {
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }

  /* ---------- 01 WHAT I REPAIR ---------- */
  .repairs { padding: 88px 0; background: var(--canvas); }
  .repair-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .repair-list li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule-strong);
  }
  .repair-list h3 {
    font-size: clamp(22px, 2.6vw, 28px);
    letter-spacing: -0.02em;
  }
  .repair-list p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
    max-width: 62ch;
  }
  @media (min-width: 760px) {
    .repair-list li { grid-template-columns: 0.8fr 1.6fr; gap: 40px; align-items: baseline; }
  }
  .repairs-foot {
    margin: 22px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
  .repairs-foot a,
  .local-note a,
  .bio-text a {
    color: var(--charcoal);
    text-decoration: none;
    border-bottom: 1px solid var(--charcoal);
  }
  .repairs-foot a:hover,
  .local-note a:hover,
  .bio-text a:hover { color: var(--rust); border-bottom-color: var(--rust); }

  /* ---------- 02 HOW IT WORKS ---------- */
  .steps {
    padding: 88px 0;
    background: var(--canvas-light);
    border-top: 2px solid var(--charcoal);
  }
  .step-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule-strong);
