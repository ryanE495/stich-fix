---
import Layout from '../../layouts/Layout.astro';
import SewnCards from '../../components/SewnCards.astro';
import { site, seo } from '../../config/site';
import { fetchPublishedPortfolio, withSlugs, categoryLabel } from '../../lib/portfolio';

const items = withSlugs(await fetchPublishedPortfolio());

// Filters come from the data: one per category that has work in it, most
// first, labeled with the same names the cards use. `hash` is what goes in the
// URL (/portfolio#canvas-tent), so a filtered view can be linked.
const counts = new Map<string, number>();
for (const item of items) counts.set(item.category, (counts.get(item.category) ?? 0) + 1);
const filters = [...counts]
  .sort((a, b) => b[1] - a[1])
  .map(([cat, n]) => ({ cat, n, label: categoryLabel(cat), hash: cat.replace(/_/g, '-') }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Portfolio — Western Slope Stitchworks',
  description:
    "Gear, canvas, and upholstery repair work completed by Western Slope Stitchworks on the Colorado Western Slope. Before and after photos of tipi patches, raft frame bag rebuilds, custom builds, and commercial canvas.",
  url: `${site.url}/portfolio/`,
  isPartOf: {
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
  },
  about: {
    '@type': 'LocalBusiness',
    '@id': seo.businessId,
  },
};
---

<Layout
  active="portfolio"
  title="Portfolio — Gear & Canvas Repair Work | WSS"
  description="Before-and-after photos of real gear, canvas, and upholstery repair: tipi patches, wall tents, raft frame bags, UTV seats, and custom builds on Colorado's Western Slope."
  canonicalPath="/portfolio/"
  jsonLd={jsonLd}
>
  <!-- HEAD -->
  <section class="page-head">
    <div class="wrap">
      <div class="section-num">§ Portfolio · Recent Work</div>
      <h1>Our Work — <em>Gear &amp; Canvas Repair on the Western Slope.</em></h1>
      <p class="page-lead">
        A running record of repairs and custom builds. Tipi patches and wall tent rebuilds, raft frame bags, UTV seats, sleeping bag conversions, RV awning mods, and the one-off jobs that don't fit a standard line item. Most of these were photographed mid-job in the shop.
      </p>
    </div>
  </section>

  {items.length === 0 ? (
    <!-- EMPTY STATE -->
    <section class="portfolio-empty">
      <div class="wrap">
        <div class="empty-inner">
          <div class="section-num">§ Coming Soon</div>
          <h2>Work samples coming soon.</h2>
          <p>
            Build-in-progress photos go up on Instagram first while the portfolio gets seeded.
            Follow <strong>@westernslopestitchworks</strong> for the latest, or text a photo of
            your project and you'll get a quote inside 24 hours.
          </p>
          <div class="empty-ctas">
            <a href={site.phoneHref} class="btn">Text {site.phoneDisplay}</a>
            <a href="/custom-builds/" class="btn btn-secondary">See custom builds &rarr;</a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <!-- GRID -->
    <section class="portfolio-grid-section" data-seam>
      <div class="wrap">
        {/* Filters need scripts; without them every job simply shows. */}
        {filters.length > 1 && (
          <div class="pf-filters" role="group" aria-label="Filter the work by kind" data-pf-filters>
            <button type="button" data-filter="all" aria-pressed="true">All <span class="pf-n">{items.length}</span></button>
            {filters.map((f) => (
              <button type="button" data-filter={f.cat} data-hash={f.hash} aria-pressed="false">
                {f.label} <span class="pf-n">{f.n}</span>
              </button>
            ))}
          </div>
        )}
        <p class="pf-status" aria-live="polite" data-pf-status></p>
        <SewnCards items={items} layout="two" arrow="See the build →" revealEach filterable />
      </div>
    </section>
  )}
</Layout>

<style>
  .page-head {
    padding: 72px 0 56px;
    background: var(--canvas-light);
    border-bottom: 2px solid var(--charcoal);
  }
  .page-head h1 {
    font-size: clamp(44px, 7vw, 96px);
    line-height: 0.96;
    letter-spacing: -0.035em;
    margin-top: 18px;
    max-width: 18ch;
    text-wrap: balance;
  }
  .page-head h1 em { font-style: italic; font-weight: 400; color: var(--river); }
  .page-lead {
    margin-top: 28px;
    font-size: 18px;
    line-height: 1.6;
    max-width: 64ch;
    color: var(--ink);
  }

  /* ---------- EMPTY ---------- */
  .portfolio-empty {
    padding: 90px 0 110px;
    background: var(--canvas);
  }
  .empty-inner { max-width: 720px; }
  .portfolio-empty h2 {
    font-size: clamp(34px, 5vw, 60px);
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 14px 0 22px;
    max-width: 18ch;
    text-wrap: balance;
  }
  .portfolio-empty p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink);
    max-width: 56ch;
    margin: 0 0 28px;
  }
  .portfolio-empty strong { color: var(--charcoal); font-weight: 600; }
  .empty-ctas { display: flex; gap: 14px; flex-wrap: wrap; }

  /* ---------- GRID ---------- */
  .portfolio-grid-section {
    padding: 70px 0 110px;
    background: var(--canvas);
  }

  /* Filters: stitched tags. The active one is filled, with a stitch inside. */
  .pf-filters { display: none; flex-wrap: wrap; gap: 10px; margin: 6px 0 48px; }
  :global(.js) .pf-filters { display: flex; }
  .pf-filters button {
    position: relative;
    appearance: none;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    padding: 9px 16px;
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: 100px;
    color: var(--charcoal);
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .pf-filters button:hover { border: 1px dashed var(--rust); color: var(--rust); }
  .pf-filters button[aria-pressed='true'] { background: var(--charcoal); border-color: var(--charcoal); color: var(--canvas); }
  .pf-filters button[aria-pressed='true']::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px dashed rgba(244, 236, 222, 0.55);
    border-radius: 100px;
    pointer-events: none;
  }
  .pf-filters button:focus-visible { outline: 2px solid var(--rust); outline-offset: 2px; }
  .pf-n { color: var(--muted); font-size: 10px; }
  .pf-filters button[aria-pressed='true'] .pf-n { color: #b0a99f; }
  /* Announces the result count to screen readers only. */
  .pf-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    margin: 0;
  }

  /* Cards rearranging after a filter change (where view transitions exist). */
  :global(::view-transition-group(*)) {
    animation-duration: 0.45s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* The page ends on the grid: no pale band above the footer. */
  :global(footer.footer) { margin-top: 0; }
</style>

<script>
  // Seam under the header sews in once the grid comes into view.
  const seams = document.querySelectorAll<HTMLElement>('[data-seam]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
    }, { threshold: 0.05 });
    seams.forEach((s) => io.observe(s));
  } else {
    seams.forEach((s) => s.classList.add('is-visible'));
  }

  // Filters: show one kind of work, keep it in the URL so it can be linked,
  // and animate the reflow where the browser supports view transitions.
  const bar = document.querySelector<HTMLElement>('[data-pf-filters]');
  const grid = document.querySelector<HTMLElement>('.sewn-cards');
  if (bar && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(':scope > .sc-card'));
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
    const status = document.querySelector<HTMLElement>('[data-pf-status]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const apply = (cat: string, animate: boolean) => {
      const update = () => {
        let shown = 0;
        for (const card of cards) {
          const on = cat === 'all' || card.dataset.cat === cat;
          card.hidden = !on;
          // A card revealed by filtering may never have scrolled into view.
          if (on) { shown++; card.classList.add('is-visible'); }
        }
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
        if (status) status.textContent = `${shown} ${shown === 1 ? 'job' : 'jobs'}`;
      };
      const vt = (document as Document & { startViewTransition?: (cb: () => void) => unknown }).startViewTransition;
      if (animate && !reduceMotion && vt) vt.call(document, update);
      else update();
    };

    bar.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-filter]');
      if (!button) return;
      const cat = button.dataset.filter!;
      apply(cat, true);
      history.replaceState(null, '', cat === 'all' ? location.pathname : `#${button.dataset.hash}`);
    });

    // Open straight to a filter from a link like /portfolio#upholstery-seats.
    const linked = buttons.find((b) => b.dataset.hash && `#${b.dataset.hash}` === location.hash);
    if (linked) apply(linked.dataset.filter!, false);
  }
</script>
