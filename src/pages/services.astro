---
import Layout from '../layouts/Layout.astro';
import { site, seo } from '../config/site';
import { categories, dontDo } from '../config/services';
import { servicePages } from '../data/service-pages';
import AreasServed from '../components/AreasServed.astro';
import RecentWorkLinks from '../components/RecentWorkLinks.astro';
import MailInCallout from '../components/MailInCallout.astro';
import PlateSwap from '../components/PlateSwap.astro';
import PortfolioPhoto from '../components/PortfolioPhoto.astro';
import BeforePrints from '../components/BeforePrints.astro';
import StitchIcon from '../components/StitchIcon.astro';
import { fetchPublishedPortfolio, withSlugs } from '../lib/portfolio';

const portfolio = withSlugs(await fetchPublishedPortfolio());
const job = (slug: string) => portfolio.find((p) => p.slug === slug);

// Hero plate: a seat rebuild, since seats are a big line on this price list
// (and the home page already leads with a wall tent).
const heroJob = job('snowmobile-2-seater-seat-full-rebuild-with-multi-panel-pattern-work');

// One real job beside each category's prices — the same jobs as the home
// page's service cards, so the two pages agree.
const CATEGORY_JOBS: Record<string, { slug: string; label: string }> = {
  outdoor: { slug: 'canvas-tipi-repair-multi-tear-restoration', label: 'Canvas tipi' },
  raft: { slug: 'nrs-raft-bag-zipper-replacement', label: 'NRS raft bag' },
  commercial: { slug: 'antique-chair-seat-rebuild-with-new-foam-welt-cord', label: 'Antique chair' },
};
const categoryPhoto = Object.fromEntries(
  Object.entries(CATEGORY_JOBS).map(([id, { slug, label }]) => {
    const j = job(slug);
    return [id, j?.after_image_url ? { src: j.after_image_url, title: j.title, label, href: `/portfolio/${slug}/` } : null];
  }),
);

// Before prints by the closing call to action: the same three jobs as the
// category photos, so each print's "after" is up the page.
const sendInPrints = [
  { slug: 'nrs-raft-bag-zipper-replacement', label: 'Raft bag' },
  { slug: 'antique-chair-seat-rebuild-with-new-foam-welt-cord', label: 'Antique chair' },
  { slug: 'stool-covers-full-rebuild-with-boxing-top-stitching-new-foam', label: 'Shop stools' },
];

// Deep-link every price-list row to its dedicated SEO page automatically —
// service-pages.ts is the single source of truth for slugs, so this can't
// drift out of sync the way hand-written hrefs on each PriceItem would.
const servicePageHrefByName = new Map(servicePages.map((p) => [p.priceItemName, `/services/${p.slug}/`]));
const priceItemHref = (name: string, explicitHref?: string) => explicitHref ?? servicePageHrefByName.get(name);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Gear, Canvas, and Upholstery Repair',
  provider: {
    '@type': 'LocalBusiness',
    '@id': seo.businessId,
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Western Slope, Colorado',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Repair Pricing',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Tipi and wall tent patches',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '60',
          maxPrice: '150',
          priceCurrency: 'USD',
        },
      },
      {
        '@type': 'Offer',
        name: 'UTV and side-by-side seat re-upholstery',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '120',
          maxPrice: '200',
          priceCurrency: 'USD',
        },
      },
      {
        '@type': 'Offer',
        name: 'Snowmobile seat re-cover',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '150',
          maxPrice: '350',
          priceCurrency: 'USD',
        },
      },
      {
        '@type': 'Offer',
        name: 'Gym equipment pad re-upholstery',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '75',
          maxPrice: '180',
          priceCurrency: 'USD',
        },
      },
    ],
  },
};
---

<Layout
  active="services"
  title={`Gear & Canvas Repair Services + Pricing | ${site.name}`}
  description="Real pricing for gear, canvas, raft, UTV, and commercial upholstery repair. Tipi patches from $60, UTV seats from $120. Free photo quotes — Delta, CO."
  canonicalPath="/services/"
  jsonLd={jsonLd}
>
  <!-- PAGE HEAD -->
  <section class="page-head">
    <div class="wrap">
      <div class="page-head-grid">
        <div class="page-head-text">
          <div class="section-num" data-hero-in style="--hero-delay: 0.05s">§ The Price List</div>
          <h1 data-hero-in style="--hero-delay: 0.18s">What I Repair</h1>
          <p class="page-intro" data-hero-in style="--hero-delay: 0.34s">
            Below is the short list — but if your gear isn't on it, ask anyway. I've probably either done it or I know the guy who can. All pricing reflects real ranges, not "starting at" traps. Send me a photo, I'll give you a real quote inside 24 hours.
          </p>
        </div>
        <div class="page-head-media" data-hero-in style="--hero-delay: 0.48s">
          {heroJob?.before_image_url && heroJob.after_image_url && (
            <PlateSwap
              before={heroJob.before_image_url}
              after={heroJob.after_image_url}
              alt="snowmobile 2-seater seat, fully rebuilt with multi-panel pattern work"
              caption="Plate 01 / Snowmobile seat, before & after"
              captionHref={`/portfolio/${heroJob.slug}/`}
              location={site.location}
              sizes="(max-width: 720px) 100vw, (max-width: 1180px) 45vw, 540px"
            />
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE CATEGORIES -->
  {categories.map((cat, ci) => {
    const photo = categoryPhoto[cat.id];
    return (
      <section class="cat" id={cat.id} data-seam>
        <div class="wrap">
          <div class="cat-head" data-reveal>
            <span class="cat-num">{cat.num}</span>
            <h2>{cat.title}</h2>
          </div>
          <div class:list={['cat-body', { 'has-photo': photo }]}>
            <ul class="price-list" data-reveal style="--reveal-delay: 140ms">
              {cat.items.map((item) => {
                const href = priceItemHref(item.name, item.href);
                return (
                  <li class="price-item">
                    <span class="pi-name">
                      {href ? <a href={href}>{item.name}</a> : item.name}
                    </span>
                    <span class="pi-price">{item.price}</span>
                  </li>
                );
              })}
            </ul>
            {photo && (
              <figure class="cat-photo" data-reveal style="--reveal-delay: 240ms">
                <a class="cat-photo-frame" href={photo.href} aria-label={`See the job: ${photo.title}`}>
                  <PortfolioPhoto src={photo.src} alt={`After the repair: ${photo.title}`} sizes="(max-width: 900px) 100vw, 360px" />
                </a>
                <figcaption class="cat-photo-cap">
                  <span><a href={photo.href}>Plate {String(ci + 2).padStart(2, '0')} / {photo.label}</a></span>
                  <span>{site.location}</span>
                </figcaption>
              </figure>
            )}
          </div>
        </div>
      </section>
    );
  })}

  <!-- GOT SOMETHING WEIRD -->
  <section class="weird">
    <div class="wrap">
      <div class="weird-inner" data-reveal>
        <h3>Got Something Weird?</h3>
        <p>If it's fabric, canvas, vinyl, or webbing and it's under about 4 layers thick, there's a good chance I can do it. Ask.</p>
      </div>
    </div>
  </section>

  <!-- SERVICE AREA STRIP -->
  <AreasServed map intro="Full price-list repairs and custom work, available across the Western Slope. Free local pickup in Montrose, Olathe & Delta — a small route fee everywhere else — and 3–7 day turnaround in each of these communities:" />

  <MailInCallout kicker="Not on the Western Slope? Ship it to us." />

  <!-- WHAT I DON'T DO -->
  <section class="dont">
    <div class="wrap">
      <h3 data-reveal>What I Don't Do (Yet)</h3>
      <ul class="dont-list" data-reveal style="--reveal-delay: 120ms">
        {dontDo.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- HOW I WORK -->
  <section class="how" data-seam>
    <div class="wrap">
      <h2 data-reveal>How I Work</h2>
      <div class="how-grid" data-reveal style="--reveal-delay: 140ms">
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <StitchIcon id="clock" delay={0.30} paths={["M16 5 A11 11 0 1 1 15.99 5","M16 9v7l4.5 3"]} />
          </div>
          <h4>Turnaround</h4>
          <p>Most jobs in 3–7 days. Rush work available on request.</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <StitchIcon id="pin" delay={0.45} paths={["M16 28s9-8 9-15a9 9 0 1 0-18 0c0 7 9 15 9 15z","M16 9.75 A3.25 3.25 0 1 1 15.99 9.75"]} />
          </div>
          <h4>Pickup</h4>
          <p>Free local pickup in Montrose, Olathe &amp; Delta. Pickup everywhere else on the Western Slope for a small route fee.</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <StitchIcon id="building" delay={0.60} paths={["M6 27V8l10-3 10 3v19","M6 27h20","M12 13h2M12 17h2M12 21h2M18 13h2M18 17h2M18 21h2"]} />
          </div>
          <h4>Commercial Accounts</h4>
          <p>Weekly or biweekly pickup. Monthly repair blocks available — ask for pricing.</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <StitchIcon id="message" delay={0.75} paths={["M6 8h20v14H14l-5 5v-5H6z","M12 14h10M12 18h7"]} />
          </div>
          <h4>Estimates</h4>
          <p>Text me a photo, get a quote in 24 hours. No fee to ask.</p>
        </div>
      </div>
      <div class="how-note" data-reveal style="--reveal-delay: 280ms">$25 shop minimum per job.</div>
    </div>
  </section>

  <!-- CUSTOM BUILDS CALLOUT -->
  <section class="custom-callout">
    <div class="wrap">
      <a class="custom-callout-link" href="/custom-builds/">
        <div class="cco-text">
          <span class="cco-kicker">§ Outside the Rate Sheet</span>
          <h2>Don&rsquo;t see your project listed?</h2>
          <p>RV awning mods, sleeping bag conversions, custom bags, hunting and outfitter custom, one-off industrial sewing &mdash; the work that doesn&rsquo;t fit a standard line item.</p>
          <span class="cco-cta">See custom builds &amp; modifications &rarr;</span>
        </div>
        <div class="cco-arrow" aria-hidden="true">→</div>
      </a>
    </div>
  </section>

  <RecentWorkLinks
    heading="See Our Recent Work"
    intro="Real repairs and custom builds from the shop — before-and-after photos and the story behind each fix."
  />

  <!-- FINAL CTA -->
  <section class="final" data-seam>
    <div class="wrap">
      <div class="final-grid">
      <div class="final-inner" data-reveal>
        <h2>Ready to Send Something In?</h2>
        <p>Text me a photo of the damage. I'll tell you what it'll cost and when I can have it back to you.</p>
        <div class="final-ctas">
          <a href={site.phoneHref} class="btn">Call or Text</a>
          <a href="/contact/" class="btn btn-secondary">Send a Photo</a>
        </div>
      </div>
        <BeforePrints jobs={sendInPrints} startPlate={5} dark data-reveal style="--reveal-delay: 160ms" />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- PAGE HEAD ---------- */
  .page-head {
    padding: 72px 0 56px;
    background: var(--canvas-light);
    border-bottom: 2px solid var(--charcoal);
  }
  .page-head-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: end;
  }
  .page-head h1 {
    font-size: clamp(48px, 8vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    margin-top: 18px;
    max-width: 12ch;
  }
  .page-intro {
    margin: 32px 0 0;
    font-size: 18px;
    line-height: 1.6;
    max-width: 58ch;
    color: var(--ink);
  }
  .page-head-image-frame {
    width: 100%;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--canvas-dark);
    border-radius: 2px;
  }
  .page-head-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .page-head-caption {
    margin-top: 14px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
  }
  @media (min-width: 960px) {
    .page-head-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 64px;
    }
  }

  /* ---------- CATEGORY / PRICE LIST ---------- */
  .cat {
    padding: 72px 0;
    border-bottom: 1px solid var(--rule-strong);
  }
  .cat:first-of-type { padding-top: 80px; }

  .cat-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .cat-num {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .cat h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .price-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .price-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule-strong);
    align-items: baseline;
  }
  .pi-name {
    font-family: var(--f-serif);
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--charcoal);
  }
  .pi-name a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .pi-name a:hover { color: var(--rust); border-bottom-color: var(--rust); }
  .pi-price {
    font-family: var(--f-mono);
    font-size: clamp(14px, 1.6vw, 15px);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--charcoal);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ---------- GOT SOMETHING WEIRD (small callout) ---------- */
  .weird {
    padding: 48px 0;
    background: var(--canvas);
  }
  .weird-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 32px;
    align-items: baseline;
    padding: 28px 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }
  .weird h3 {
    font-size: clamp(22px, 2.6vw, 28px);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .weird p {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    max-width: 58ch;
    color: var(--ink);
  }

  /* ---------- WHAT I DON'T DO (footnote-feel) ---------- */
  .dont {
    padding: 48px 0 56px;
    background: var(--canvas-light);
  }
  .dont h3 {
    font-family: var(--f-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .dont-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }
  .dont-list li {
    font-family: var(--f-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    position: relative;
    padding-left: 18px;
  }
  /* A cross-stitch where the dash was: these are the jobs the shop turns down. */
  .dont-list li::before {
    content: '×';
    position: absolute;
    left: 0;
    color: var(--rust);
    font-weight: 600;
  }

  /* ---------- HOW I WORK ---------- */
  .how {
    padding: 88px 0 100px;
    background: var(--canvas);
    border-top: 2px solid var(--charcoal);
  }
  .how h2 {
    font-size: clamp(32px, 4.4vw, 52px);
    letter-spacing: -0.03em;
    margin: 0 auto 36px;
    max-width: 14ch;
    text-align: center;
  }
  .how-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }
  .how-card {
    padding: 32px 16px;
    border-bottom: 1px solid var(--rule-strong);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }
  .how-card:last-child { border-bottom: none; }
  .how-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--river);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: var(--canvas-light);
    flex-shrink: 0;
  }
  .how-icon svg { width: 22px; height: 22px; }
  .how-card h4 {
    font-family: var(--f-serif);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--charcoal);
  }
  .how-card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 42ch;
  }
  .how-note {
    margin-top: 28px;
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
  }

  /* ---------- FINAL CTA ---------- */
  .final {
    padding: 110px 0;
    background: var(--charcoal);
    color: var(--canvas);
    text-align: left;
  }
  .final-inner { max-width: 780px; }
  .final h2 {
    color: var(--canvas);
    font-size: clamp(40px, 5.6vw, 72px);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
    max-width: 16ch;
  }
  .final p {
    font-size: 19px;
    line-height: 1.55;
    max-width: 54ch;
    margin: 0 0 32px;
    color: #d9c9a8;
  }
  .final-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .final :global(.btn) {
    background: var(--canvas);
    color: var(--charcoal);
    border-color: var(--canvas);
  }
  .final :global(.btn:hover) {
    background: #fff;
    color: var(--charcoal);
  }
  .final :global(.btn-secondary) {
    background: transparent;
    color: var(--canvas);
    border-color: var(--canvas);
  }
  .final :global(.btn-secondary:hover) {
    background: var(--canvas);
    color: var(--charcoal);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (min-width: 640px) {
    .how-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0 32px;
    }
    .how-card {
      padding: 36px 16px;
    }
    .how-card:nth-last-child(-n+2) { border-bottom: none; }
  }

  @media (min-width: 960px) {
    .how h2 {
      margin-left: 0;
      margin-right: 0;
      text-align: left;
    }
    .how-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
    .how-card {
      align-items: flex-start;
      text-align: left;
      gap: 18px;
      padding: 36px 24px 36px 0;
      border-right: 1px solid var(--rule-strong);
      border-bottom: none;
    }
    .how-card:not(:first-child) { padding-left: 24px; }
    .how-card:last-child { border-right: none; padding-right: 0; }
    .how-note { text-align: left; }
  }

  @media (max-width: 639px) {
    .weird-inner { grid-template-columns: 1fr; gap: 12px; }
    .pi-name { font-size: 16px; }
    .pi-price { font-size: 13px; }
    .price-item { gap: 14px; }
  }

  /* ========== REDESIGN: stitching and real work ========== */

  /* Category body: the price list, with a real job beside it. */
  .cat-body.has-photo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 56px;
    align-items: start;
  }
  .cat-photo { margin: 6px 0 0; position: sticky; top: 110px; }
  .cat-photo-frame {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--canvas-dark);
    border-radius: 2px;
  }
  .cat-photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cat-photo-frame::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1.5px dashed rgba(244, 236, 222, 0.9);
    border-radius: 1px;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.35s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  .cat-photo-frame:hover :global(img),
  .cat-photo-frame:focus-visible :global(img) { transform: scale(1.05); }
  .cat-photo-frame:hover::after,
  .cat-photo-frame:focus-visible::after { opacity: 1; transform: none; }
  .cat-photo-cap {
    margin-top: 12px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cat-photo-cap a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--rule-strong); }
  .cat-photo-cap a:hover { color: var(--rust); border-bottom-color: var(--rust); }
  .cat-photo-cap > span:last-child { white-space: nowrap; }
  @media (max-width: 900px) {
    .cat-body.has-photo { grid-template-columns: 1fr; gap: 32px; }
    .cat-photo { position: static; max-width: 460px; }
  }

  /* Price rows: hovering one sews a stitch along its bottom edge. */
  .price-item { position: relative; }
  .price-item::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--rust) 0 9px, transparent 9px 15px);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.55s cubic-bezier(0.65, 0, 0.35, 1);
    pointer-events: none;
  }
  .price-item:hover::after,
  .price-item:focus-within::after { clip-path: inset(0); }
  .pi-price { transition: color 0.2s ease; }
  .price-item:hover .pi-price { color: var(--rust); }

  /* "Got Something Weird?" — sewn on like a patch: a running stitch travels
     top, right, bottom, then left around the box when it scrolls in. Each side
     is a background layer whose length is a registered custom property. */
  @property --sew-t { syntax: '<percentage>'; inherits: false; initial-value: 100%; }
  @property --sew-r { syntax: '<percentage>'; inherits: false; initial-value: 100%; }
  @property --sew-b { syntax: '<percentage>'; inherits: false; initial-value: 100%; }
  @property --sew-l { syntax: '<percentage>'; inherits: false; initial-value: 100%; }
  .weird-inner {
    position: relative;
    border: none;
    padding: 34px 36px;
  }
  .weird-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    --st: repeating-linear-gradient(90deg, var(--rust) 0 11px, transparent 11px 18px);
    --sv: repeating-linear-gradient(180deg, var(--rust) 0 11px, transparent 11px 18px);
    background:
      var(--st) left top / var(--sew-t) 2px no-repeat,
      var(--sv) right top / 2px var(--sew-r) no-repeat,
      var(--st) right bottom / var(--sew-b) 2px no-repeat,
      var(--sv) left bottom / 2px var(--sew-l) no-repeat;
  }
  @keyframes sew-box {
    0% { --sew-t: 0%; --sew-r: 0%; --sew-b: 0%; --sew-l: 0%; }
    30% { --sew-t: 100%; --sew-r: 0%; --sew-b: 0%; --sew-l: 0%; }
    50% { --sew-t: 100%; --sew-r: 100%; --sew-b: 0%; --sew-l: 0%; }
    80% { --sew-t: 100%; --sew-r: 100%; --sew-b: 100%; --sew-l: 0%; }
    100% { --sew-t: 100%; --sew-r: 100%; --sew-b: 100%; --sew-l: 100%; }
  }
  :global(.js) .weird-inner:not(.is-visible)::before { --sew-t: 0%; --sew-r: 0%; --sew-b: 0%; --sew-l: 0%; }
  :global(.js) .weird-inner.is-visible::before { animation: sew-box 2.2s cubic-bezier(0.45, 0, 0.55, 1) 0.35s both; }

  /* How I Work: the stitched icons sew in; cards pick up a stitch on hover. */
  .how-icon { transition: border-color 0.25s ease, background 0.25s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  .how-card:hover .how-icon { border: 1px dashed var(--rust); background: var(--canvas); transform: rotate(-6deg); }

  /* Final call to action, with the before prints beside it. */
  .final-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 900px) {
    .final-grid { grid-template-columns: 1fr; gap: 24px; }
  }
  /* The page ends on this dark section; with the footer's top margin a pale
     band would show between two dark blocks. A hairline keeps them distinct. */
  :global(footer.footer) { margin-top: 0; }
  .final { border-bottom: 1px solid rgba(255, 255, 255, 0.1); }

  @media (prefers-reduced-motion: reduce) {
    .price-item::after { transition: none; }
    :global(.js) .weird-inner::before { animation: none !important; --sew-t: 100%; --sew-r: 100%; --sew-b: 100%; --sew-l: 100%; }
    .cat-photo-frame :global(img), .cat-photo-frame::after, .how-icon { transition: none; }
  }

  /* ========== ANIMATIONS ========== */
  [data-hero-in] {
    opacity: 0;
    transform: translateY(18px);
    animation: heroIn 0.95s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--hero-delay, 0s);
  }
  @keyframes heroIn {
    to { opacity: 1; transform: none; }
  }

  /* Hidden-until-revealed only when scripts run; without JS everything shows. */
  :global(.js) [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0s);
    will-change: opacity, transform;
  }
  :global(.js) [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-in],
    :global(.js) [data-reveal] {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  // Sections fade up, and seams sew in, as they come into view.
  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal], [data-seam]');
  if (reveals.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -10% 0px' }
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-visible'));
  }
</script>
