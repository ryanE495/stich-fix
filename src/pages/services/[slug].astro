---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { site, seo } from '../../config/site';
import { serviceAreas, HERO } from '../../data/service-areas';
import { servicePages, sharedHowItWorks, type ServicePage } from '../../data/service-pages';
import { fetchPublishedPortfolio, withSlugs, pickThumbnail, categoryLabel } from '../../lib/portfolio';

export function getStaticPaths() {
  return servicePages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: ServicePage };
const canonicalPath = `/services/${page.slug}/`;

// Real photos only — filtered from the live portfolio when a match exists.
// No filter (or no match) falls back to the homepage hero image, same as
// the rest of the shop's SEO pages.
const allPortfolio = withSlugs(await fetchPublishedPortfolio());
const matchedWork = page.portfolioFilter ? allPortfolio.filter(page.portfolioFilter) : [];

const heroPortfolioItem = matchedWork.find((p) => p.after_image_url) || matchedWork[0];
const heroImage = (heroPortfolioItem && pickThumbnail(heroPortfolioItem)) || HERO.sewing;
const heroImageAlt = heroPortfolioItem
  ? `${heroPortfolioItem.title} — ${page.h1.toLowerCase()} by Western Slope Stitchworks`
  : 'Industrial sewing machine stitching heavy canvas in the Western Slope Stitchworks shop';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.h1,
  serviceType: page.h1,
  description: page.metaDescription,
  url: `${site.url}${canonicalPath}`,
  provider: {
    '@type': 'LocalBusiness',
    '@id': seo.businessId,
  },
  areaServed: serviceAreas.map((a) => ({
    '@type': 'City',
    name: `${a.cityName}, ${a.state}`,
  })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: page.h1,
    itemListElement: page.whatGetsFixed.map((w) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: w.name },
    })),
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<Layout
  active="services"
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
  jsonLd={[serviceJsonLd, faqJsonLd]}
  breadcrumbs={[{ name: 'Services & Pricing', path: '/services/' }]}
>
  <!-- HERO -->
  <section class="page-head">
    <div class="wrap">
      <div class="section-num">{page.eyebrow}</div>
      <h1>{page.h1}</h1>
      <div class="page-head-grid">
        <div class="page-head-text">
          <p class="page-tagline">{page.tagline}</p>
          <p class="page-body">{page.intro}</p>
          <div class="page-ctas">
            <a href={site.phoneHref} class="btn">Text a photo to {site.phoneDisplay}</a>
            <a href="/contact/" class="btn btn-secondary">Use the contact form &rarr;</a>
          </div>
        </div>
        <div class="page-head-media">
          <div class="page-head-image-frame">
            <Image
              class="page-head-image"
              src={heroImage}
              width={1280}
              height={960}
              widths={[480, 768, 1280]}
              sizes="(max-width: 720px) 100vw, (max-width: 1180px) 45vw, 540px"
              format="webp"
              quality={82}
              alt={heroImageAlt}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
          <div class="page-head-caption">
            <span>{page.heroCaption}</span>
            <span>{site.location}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT GETS FIXED -->
  <section class="fixed">
    <div class="wrap">
      <div class="fixed-head">
        <div class="section-num">§ What Gets Fixed</div>
        <h2>{page.whatGetsFixedHeading}</h2>
      </div>
      <ul class="fixed-grid">
        {page.whatGetsFixed.map((item, i) => (
          <li class="fixed-card">
            <div class="fixed-num">{String(i + 1).padStart(2, '0')} / Repair</div>
            <h3>{item.name}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
      {page.crossLink && (
        <p class="cross-link">
          <strong>{page.crossLink.lead}</strong> {page.crossLink.body} <a href={page.crossLink.href}>{page.crossLink.cta}</a>
        </p>
      )}
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how">
    <div class="wrap">
      <h2>How It Works</h2>
      <div class="how-grid">
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 12l2.2-3.2h4.2L14.6 12H24a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V14a2 2 0 0 1 2-2z" />
              <circle cx="16" cy="19" r="4" />
            </svg>
          </div>
          <h4>{sharedHowItWorks[0].title}</h4>
          <p>{sharedHowItWorks[0].body}</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 8h20v14H14l-5 5v-5H6z" />
              <path d="M12 14h10M12 18h7" />
            </svg>
          </div>
          <h4>{sharedHowItWorks[1].title}</h4>
          <p>{sharedHowItWorks[1].body}</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 28s9-8 9-15a9 9 0 1 0-18 0c0 7 9 15 9 15z" />
              <circle cx="16" cy="13" r="3.25" />
            </svg>
          </div>
          <h4>{sharedHowItWorks[2].title}</h4>
          <p>{sharedHowItWorks[2].body}</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="16" cy="16" r="11" />
              <path d="M16 9v7l4.5 3" />
            </svg>
          </div>
          <h4>{sharedHowItWorks[3].title}</h4>
          <p>{sharedHowItWorks[3].body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="gallery">
    <div class="wrap">
      <div class="gallery-head">
        <div class="section-num">§ Recent Work</div>
        <h2>Real Jobs, <em>Real Fixes.</em></h2>
        <p class="gallery-intro">Before-and-after photos from actual jobs that have come through the shop. More go up here as new work wraps.</p>
      </div>
      {matchedWork.length > 0 ? (
        <ul class="portfolio-grid">
          {matchedWork.map((item) => {
            const thumb = pickThumbnail(item);
            return (
              <li class="portfolio-card">
                <a href={`/portfolio/${item.slug}/`}>
                  <div class="card-media">
                    {thumb ? (
                      <img src={thumb} alt={`${item.title} — ${categoryLabel(item.category)}`} loading="lazy" decoding="async" />
                    ) : (
                      <div class="card-media-empty" aria-hidden="true"></div>
                    )}
                  </div>
                  <div class="card-body">
                    <span class="card-category">{page.h1}</span>
                    <h3 class="card-title">{item.title}</h3>
                    <span class="card-arrow">See the build &rarr;</span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="gallery-empty">{page.galleryEmptyCopy}</p>
      )}
      <a href="/portfolio/" class="btn btn-secondary gallery-cta">See the full portfolio &rarr;</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="wrap">
      <div class="faq-head">
        <div class="section-num">§ Questions</div>
        <h2>{page.h1}, <em>Straight Answers.</em></h2>
      </div>
      <ul class="faq-list">
        {page.faqs.map((item) => (
          <li class="faq-item">
            <h3 class="faq-q">{item.q}</h3>
            <p class="faq-a">{item.a}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="city-cta">
    <div class="wrap">
      <div class="city-cta-inner">
        <div class="section-num">§ Next Step</div>
        <h2>Text a photo to <em>{site.phoneDisplay}</em><br />— quote back in 24 hours.</h2>
        <p>Send a photo of the damage and I'll come back with a real number and a turnaround date. No estimate fee, no obligation.</p>
        <div class="city-cta-row">
          <a href={site.phoneHref} class="btn">Call or Text {site.phoneDisplay}</a>
          <a href="/contact/" class="btn btn-secondary">Use the contact form &rarr;</a>
        </div>
        <div class="city-cta-small">$25 shop minimum &middot; {site.hours} &middot; {site.location}</div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- HERO (matches services.astro / sun-shades.astro / canvas-tent-repair.astro page-head) ---------- */
  .page-head {
    padding: 72px 0 56px;
    background: var(--canvas-light);
    border-bottom: 2px solid var(--charcoal);
  }
  .page-head h1 {
    font-size: clamp(48px, 8.2vw, 124px);
    line-height: 0.94;
    letter-spacing: -0.04em;
    font-weight: 600;
    margin-top: 18px;
    max-width: 16ch;
    text-wrap: balance;
  }
  .page-head-grid {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--rule-strong);
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: start;
  }
  .page-tagline {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
    max-width: 52ch;
    color: var(--ink);
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 500;
  }
  .page-body {
    margin: 18px 0 0;
    font-size: 16px;
    line-height: 1.6;
    max-width: 54ch;
    color: var(--ink);
  }
  .page-ctas {
    margin-top: 28px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .page-head-image-frame {
    width: 100%;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--canvas-dark);
    border-radius: 2px;
  }
  .page-head-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .page-head-caption {
    margin-top: 14px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
  }
  @media (min-width: 960px) {
    .page-head-grid { grid-template-columns: 1.1fr 1fr; gap: 64px; }
  }

  /* ---------- WHAT GETS FIXED (exact reuse of the canvas-tent-repair.astro odd/even grid pattern) ---------- */
  .fixed {
    padding: 80px 0;
    background: var(--canvas);
  }
  .fixed-head { margin-bottom: 40px; }
  .fixed h2 {
    font-size: clamp(30px, 4vw, 52px);
    letter-spacing: -0.03em;
    margin-top: 14px;
    max-width: 24ch;
    text-wrap: balance;
  }
  .fixed-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }
  .fixed-card {
    padding: 28px 0;
    border-bottom: 1px solid var(--rule-strong);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fixed-card:last-child { border-bottom: none; }
  .fixed-num {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .fixed-card h3 {
    font-family: var(--f-serif);
    font-weight: 600;
    font-size: clamp(20px, 2.4vw, 24px);
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--charcoal);
    max-width: 26ch;
  }
  .fixed-card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 46ch;
  }
  .cross-link {
    margin: 28px 0 0;
    padding: 20px 24px;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: var(--canvas-light);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
    max-width: 68ch;
  }
  .cross-link strong { color: var(--charcoal); }
  .cross-link a {
    color: var(--charcoal);
    border-bottom: 1px solid var(--charcoal);
    text-decoration: none;
    white-space: nowrap;
  }
  .cross-link a:hover { color: var(--rust); border-bottom-color: var(--rust); }
  @media (min-width: 720px) {
    .fixed-grid { grid-template-columns: repeat(2, 1fr); column-gap: 48px; border-bottom: none; }
    .fixed-card { padding: 32px 0; border-bottom: 1px solid var(--rule-strong); }
    .fixed-grid > .fixed-card:nth-last-child(-n+2):not(:last-child) { border-bottom: 1px solid var(--rule-strong); }
    .fixed-grid > .fixed-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      border-bottom: none;
    }
  }

  /* ---------- HOW IT WORKS (exact reuse of services.astro how-grid component) ---------- */
  .how {
    padding: 88px 0 100px;
    background: var(--canvas-light);
    border-top: 2px solid var(--charcoal);
  }
  .how h2 {
    font-size: clamp(32px, 4.4vw, 52px);
    letter-spacing: -0.03em;
    margin: 0 auto 36px;
    max-width: 14ch;
    text-align: center;
  }
  .how-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }
  .how-card {
    padding: 32px 16px;
    border-bottom: 1px solid var(--rule-strong);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }
  .how-card:last-child { border-bottom: none; }
  .how-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--river);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: var(--canvas);
    flex-shrink: 0;
  }
  .how-icon svg { width: 22px; height: 22px; }
  .how-card h4 {
    font-family: var(--f-serif);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--charcoal);
  }
  .how-card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 42ch;
  }

  /* ---------- GALLERY (exact reuse of portfolio/index.astro portfolio-grid component) ---------- */
  .gallery {
    padding: 88px 0;
    background: var(--canvas);
    border-top: 2px solid var(--charcoal);
  }
  .gallery-head { max-width: 64ch; margin-bottom: 44px; }
  .gallery h2 {
    font-size: clamp(30px, 4vw, 52px);
    letter-spacing: -0.03em;
    margin-top: 14px;
    text-wrap: balance;
  }
  .gallery h2 em { font-style: italic; color: var(--river); font-weight: 400; }
  .gallery-intro {
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }
  .gallery-empty {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 56ch;
    padding: 28px 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }
  .portfolio-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px 28px;
  }
  .portfolio-card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .card-media {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--canvas-dark);
    border-radius: 2px;
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .card-media-empty {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(45deg, #c9b590 0 14px, #d4c3a0 14px 28px);
  }
  .portfolio-card a:hover .card-media img { transform: scale(1.03); }
  .card-body { padding: 18px 2px 4px; }
  .card-category {
    display: block;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 10px;
  }
  .card-title {
    font-family: var(--f-serif);
    font-weight: 600;
    font-size: clamp(22px, 2.6vw, 28px);
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    color: var(--charcoal);
    text-wrap: balance;
  }
  .card-arrow {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--charcoal);
    border-bottom: 1px solid var(--charcoal);
    padding-bottom: 2px;
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .portfolio-card a:hover .card-arrow { color: var(--rust); border-bottom-color: var(--rust); }
  .gallery-cta { margin-top: 44px; }

  /* ---------- FAQ ---------- */
  .faq {
    padding: 88px 0;
    background: var(--canvas-light);
    border-top: 2px solid var(--charcoal);
  }
  .faq-head { max-width: 64ch; margin-bottom: 40px; }
  .faq h2 {
    font-size: clamp(30px, 4vw, 52px);
    letter-spacing: -0.03em;
    margin-top: 14px;
    text-wrap: balance;
  }
  .faq h2 em { font-style: italic; color: var(--river); font-weight: 400; }
  .faq-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule-strong);
    max-width: 72ch;
  }
  .faq-item {
    padding: 26px 0;
    border-bottom: 1px solid var(--rule-strong);
  }
  .faq-q {
    font-family: var(--f-serif);
    font-weight: 600;
    font-size: clamp(19px, 2.2vw, 23px);
    letter-spacing: -0.015em;
    margin: 0 0 10px;
    color: var(--charcoal);
  }
  .faq-a {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
  }

  /* ---------- CTA (exact reuse of service-areas city-cta component) ---------- */
  .city-cta {
    padding: 110px 0;
    background: var(--charcoal);
    color: var(--canvas);
  }
  .city-cta :global(.section-num) { color: #b0a99f; }
  .city-cta-inner { max-width: 820px; }
  .city-cta h2 {
    color: var(--canvas);
    font-size: clamp(36px, 5.4vw, 72px);
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 18px 0 24px;
    max-width: 28ch;
    text-wrap: balance;
  }
  .city-cta h2 em { font-style: italic; color: var(--rust); font-weight: 400; }
  .city-cta p {
    font-size: 18px;
    line-height: 1.55;
    max-width: 56ch;
    margin: 0 0 32px;
    color: #d9c9a8;
  }
  .city-cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .city-cta :global(.btn) {
    background: var(--canvas);
    color: var(--charcoal);
    border-color: var(--canvas);
  }
  .city-cta :global(.btn:hover) { background: #fff; color: var(--charcoal); }
  .city-cta :global(.btn-secondary) {
    background: transparent;
    color: var(--canvas);
    border-color: var(--canvas);
  }
  .city-cta :global(.btn-secondary:hover) {
    background: var(--canvas);
    color: var(--charcoal);
  }
  .city-cta-small {
    margin-top: 28px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b0a99f;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (min-width: 640px) {
    .how-grid { grid-template-columns: repeat(2, 1fr); gap: 0; }
    .how-card { padding: 36px 16px; }
    .how-card:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (min-width: 720px) {
    .portfolio-grid { grid-template-columns: repeat(2, 1fr); gap: 64px 48px; }
  }
  @media (min-width: 960px) {
    .how h2 { margin-left: 0; margin-right: 0; text-align: left; }
    .how-grid { grid-template-columns: repeat(4, 1fr); }
    .how-card {
      align-items: flex-start;
      text-align: left;
      gap: 18px;
      padding: 36px 24px 36px 0;
      border-right: 1px solid var(--rule-strong);
      border-bottom: none;
    }
    .how-card:not(:first-child) { padding-left: 24px; }
    .how-card:last-child { border-right: none; padding-right: 0; }
  }
  @media (min-width: 1100px) {
    .portfolio-grid { gap: 80px 56px; }
  }
</style>
