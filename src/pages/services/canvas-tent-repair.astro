---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { site, seo } from '../../config/site';
import { serviceAreas, HERO } from '../../data/service-areas';
import { categories } from '../../config/services';
import { fetchPublishedPortfolio, withSlugs, pickThumbnail, categoryLabel } from '../../lib/portfolio';
import MailInCallout from '../../components/MailInCallout.astro';

const canonicalPath = '/services/canvas-tent-repair/';

// Canvas tent work is pulled live from the portfolio, so the hero image and
// gallery below stay accurate as new tent jobs get published — no code
// change needed later. Same pattern as the sun shades page.
const allPortfolio = withSlugs(await fetchPublishedPortfolio());
const tentWork = allPortfolio.filter((p) => p.category === 'canvas_tent');

// Prefer a job with a real after-photo for the hero; fall back to whatever's first.
const heroPortfolioItem = tentWork.find((p) => p.after_image_url) || tentWork[0];
const heroImage = (heroPortfolioItem && pickThumbnail(heroPortfolioItem)) || HERO.sewing;
const heroImageAlt = heroPortfolioItem
  ? `${heroPortfolioItem.title} — canvas tent repair by Western Slope Stitchworks`
  : 'Industrial sewing machine stitching heavy canvas in the Western Slope Stitchworks shop';

// Deep-link the zipper-repair line item to the real zipper job in the portfolio, if published.
const zipperJob = tentWork.find((p) => p.title.toLowerCase().includes('zipper'));

// Real published price, pulled from the single source of truth so this page
// never drifts from what's on Services & Pricing.
const tentPatchPrice =
  categories.flatMap((c) => c.items).find((i) => i.name === 'Tipi & wall tent patches')?.price ?? '$60 – $150';

const whatGetsFixed = [
  {
    name: 'Wall Panel Tears, Rips & Blowouts',
    body: 'Patched clean or replaced panel-by-panel, depending on how far the damage runs.',
  },
  {
    name: 'Tent Zipper Repair',
    body: 'Door zippers, window zippers, screen zippers — one of the most common jobs that comes through the shop.',
    href: zipperJob ? `/portfolio/${zipperJob.slug}/` : undefined,
  },
  {
    name: 'Tent Pole Repair',
    body: 'Bent, cracked, or snapped poles get splinted or replaced, along with the sleeve or grommet around them if that’s part of the problem.',
  },
  {
    name: 'Seam & Stitching Failure',
    body: 'Reinforced on the same industrial walking-foot machine that handles every canvas job in the shop.',
  },
  {
    name: 'Mildew & Rot Damage Assessment',
    body: 'Send photos and I’ll tell you honestly whether it’s a repair or the fabric’s too far gone to save.',
  },
];

const pricing = [
  { name: 'Tipi & wall tent patches', price: tentPatchPrice },
  { name: 'Tent pole repair', price: 'Quote by job' },
  { name: 'Tent zipper replacement', price: 'Quote by job' },
];

const howItWorks = [
  { title: 'Send a Photo', body: 'Text a photo of the damage — a tear, a busted zipper, a bent pole, whatever it is.' },
  { title: 'Real Quote in 24 Hours', body: 'I’ll come back with an honest number and a turnaround date. No estimate fee.' },
  { title: 'Drop Off or Ship It In', body: 'Bring it to Montrose, or box it up and send it — jobs come in from across CO and UT.' },
  { title: 'Pickup or Return', body: 'Free local pickup in Montrose, Olathe & Delta. Western Slope routes and shipping cover the rest.' },
];

const faqs = [
  {
    q: 'Canvas vs. poly tent repair — do you work on both?',
    a: 'Mostly canvas — that’s the shop’s specialty and where the industrial walking-foot machine really earns its keep. Lighter poly and nylon tent fabric is usually fine too. If you’re not sure what yours is, send a photo and I’ll tell you.',
  },
  {
    q: 'Can a torn panel be patched, or does it need full replacement?',
    a: 'Depends on where the tear is and how the canvas around it is holding up. Most tears patch clean. If a whole panel’s rotted or the fabric’s too far gone to hold a stitch, I’ll tell you straight rather than sew something that won’t last.',
  },
  {
    q: 'Do you repair tent poles, or just fabric?',
    a: 'Both. Bent, cracked, or snapped poles get splinted or replaced, and I’ll fix the webbing or grommets around the pole sleeve at the same time if that’s part of the problem.',
  },
  {
    q: 'How long does a typical tent repair take?',
    a: '3–7 days on most jobs, same as everything else in the shop. Bigger outfitter-size tents or multi-panel jobs can run longer — I’ll give you a real date with the quote, not a guess.',
  },
  {
    q: 'Do I need to ship the tent, or can I drop it off in Montrose?',
    a: 'Drop it off if you’re anywhere on the Western Slope — free local pickup in Montrose, Olathe, and Delta, and pickup routes run through the rest of the region for a small fee. Shipping works fine too if you’re farther out; just box it up and send it in.',
  },
];

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Canvas Tent Repair',
  serviceType: 'Canvas Tent, Wall Tent & Tipi Repair',
  description:
    'Canvas tent repair for wall tents, tipis, and bell tents. Wall panel patches, tent zipper repair, tent pole repair, seam and stitching failure, mildew and rot damage assessment.',
  url: `${site.url}${canonicalPath}`,
  provider: {
    '@type': 'LocalBusiness',
    '@id': seo.businessId,
  },
  areaServed: serviceAreas.map((a) => ({
    '@type': 'City',
    name: `${a.cityName}, ${a.state}`,
  })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Canvas Tent Repair Pricing',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Tipi and wall tent patches',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '60',
          maxPrice: '150',
          priceCurrency: 'USD',
        },
      },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Tent pole repair' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Tent zipper replacement' } },
    ],
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<Layout
  active="services"
  title="Canvas Tent Repair — Wall Tents & Tipis | Western Slope Stitchworks"
  description="Canvas tent repair for wall tents, tipis, and bell tents. Panel patches, tent zipper repair, tent pole repair, seam work. Montrose, CO — real quote in 24 hours."
  canonicalPath={canonicalPath}
  jsonLd={[serviceJsonLd, faqJsonLd]}
  breadcrumbs={[{ name: 'Services & Pricing', path: '/services/' }]}
>
  <!-- HERO -->
  <section class="page-head">
    <div class="wrap">
      <div class="section-num">§ Canvas Tent Repair</div>
      <h1>Canvas Tent Repair</h1>
      <div class="page-head-grid">
        <div class="page-head-text">
          <p class="page-tagline">Wall tents, tipis, bell tents — real canvas tent repair, not a guess. Patches, zippers, pole repair, seam work, the works.</p>
          <p class="page-body">Whether you found this searching tent repair near me, tarp repair near me, or just asked around Montrose — this is the shop. Send a photo, I'll give you a real quote inside 24 hours.</p>
          <div class="page-ctas">
            <a href={site.phoneHref} class="btn">Text a photo to {site.phoneDisplay}</a>
            <a href="/contact/" class="btn btn-secondary">Use the contact form &rarr;</a>
          </div>
        </div>
        <div class="page-head-media">
          <div class="page-head-image-frame">
            <Image
              class="page-head-image"
              src={heroImage}
              width={1280}
              height={960}
              widths={[480, 768, 1280]}
              sizes="(max-width: 720px) 100vw, (max-width: 1180px) 45vw, 540px"
              format="webp"
              quality={82}
              alt={heroImageAlt}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
          <div class="page-head-caption">
            <span>Plate 01 / Wall Tent</span>
            <span>{site.location}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT GETS FIXED -->
  <section class="fixed">
    <div class="wrap">
      <div class="fixed-head">
        <div class="section-num">§ What Gets Fixed</div>
        <h2>Real Canvas Tent Damage, <em>Fixed for Real.</em></h2>
      </div>
      <ul class="fixed-grid">
        {whatGetsFixed.map((item, i) => (
          <li class="fixed-card">
            <div class="fixed-num">{String(i + 1).padStart(2, '0')} / Repair</div>
            <h3>{item.href ? <a href={item.href}>{item.name}</a> : item.name}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PRICING -->
  <section class="cat">
    <div class="wrap">
      <div class="cat-head">
        <span class="cat-num">§ Pricing</span>
        <h2>Tent Repair Pricing</h2>
      </div>
      <ul class="price-list">
        {pricing.map((item) => (
          <li class="price-item">
            <span class="pi-name">{item.name}</span>
            <span class="pi-price">{item.price}</span>
          </li>
        ))}
      </ul>
      <p class="cat-foot">Pole and zipper work is quoted by the job since every tent's different — send a photo and I'll give you a real number, not a guess. For the full shop price list, see <a href="/services/">Services &amp; Pricing</a>.</p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how">
    <div class="wrap">
      <h2>How It Works</h2>
      <div class="how-grid">
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 12l2.2-3.2h4.2L14.6 12H24a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V14a2 2 0 0 1 2-2z" />
              <circle cx="16" cy="19" r="4" />
            </svg>
          </div>
          <h4>{howItWorks[0].title}</h4>
          <p>{howItWorks[0].body}</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 8h20v14H14l-5 5v-5H6z" />
              <path d="M12 14h10M12 18h7" />
            </svg>
          </div>
          <h4>{howItWorks[1].title}</h4>
          <p>{howItWorks[1].body}</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 27V8l10-3 10 3v19" />
              <path d="M6 27h20" />
              <path d="M12 13h2M12 17h2M12 21h2M18 13h2M18 17h2M18 21h2" />
            </svg>
          </div>
          <h4>{howItWorks[2].title}</h4>
          <p>{howItWorks[2].body}</p>
        </div>
        <div class="how-card">
          <div class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 28s9-8 9-15a9 9 0 1 0-18 0c0 7 9 15 9 15z" />
              <circle cx="16" cy="13" r="3.25" />
            </svg>
          </div>
          <h4>{howItWorks[3].title}</h4>
          <p>{howItWorks[3].body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="gallery">
    <div class="wrap">
      <div class="gallery-head">
        <div class="section-num">§ Recent Tent Repair Work</div>
        <h2>Real Tents, <em>Real Fixes.</em></h2>
        <p class="gallery-intro">Before-and-after photos from actual wall tent, tipi, and canvas tent jobs that have come through the shop. More go up here as new jobs wrap.</p>
      </div>
      {tentWork.length > 0 ? (
        <ul class="portfolio-grid">
          {tentWork.map((item) => {
            const thumb = pickThumbnail(item);
            return (
              <li class="portfolio-card">
                <a href={`/portfolio/${item.slug}/`}>
                  <div class="card-media">
                    {thumb ? (
                      <img src={thumb} alt={`${item.title} — ${categoryLabel(item.category)}`} loading="lazy" decoding="async" />
                    ) : (
                      <div class="card-media-empty" aria-hidden="true"></div>
                    )}
                  </div>
                  <div class="card-body">
                    <span class="card-category">Canvas &amp; Wall Tent</span>
                    <h3 class="card-title">{item.title}</h3>
                    <span class="card-arrow">See the build &rarr;</span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="gallery-empty">Photos from tent repair jobs are getting added to the portfolio. Text a photo of your own project and it might be the next one up.</p>
      )}
      <a href="/portfolio/" class="btn btn-secondary gallery-cta">See the full portfolio &rarr;</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="wrap">
      <div class="faq-head">
        <div class="section-num">§ Questions</div>
        <h2>Tent Repair, <em>Straight Answers.</em></h2>
      </div>
      <ul class="faq-list">
        {faqs.map((item) => (
          <li class="faq-item">
            <h3 class="faq-q">{item.q}</h3>
            <p class="faq-a">{item.a}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <MailInCallout />

  <!-- CTA -->
  <section class="city-cta">
    <div class="wrap">
      <div class="city-cta-inner">
        <div class="section-num">§ Next Step</div>
        <h2>Text a photo of the tent to <em>{site.phoneDisplay}</em><br />— quote back in 24 hours.</h2>
        <p>Torn panel, busted zipper, bent pole — whatever it is, send a photo and I'll come back with a real number and a turnaround date. No estimate fee, no obligation.</p>
        <div class="city-cta-row">
          <a href={site.phoneHref} class="btn">Call or Text {site.phoneDisplay}</a>
          <a href="/contact/" class="btn btn-secondary">Use the contact form &rarr;</a>
        </div>
        <div class="city-cta-small">$25 shop minimum &middot; {site.hours} &middot; {site.location}</div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- HERO (matches services.astro / sun-shades.astro page-head) ---------- */
  .page-head {
    padding: 72px 0 56px;
    background: var(--canvas-light);
    border-bottom: 2px solid var(--charcoal);
  }
  .page-head h1 {
    font-size: clamp(48px, 8.2vw, 124px);
    line-height: 0.94;
    letter-spacing: -0.04em;
    font-weight: 600;
    margin-top: 18px;
    max-width: 16ch;
    text-wrap: balance;
  }
  .page-head-grid {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--rule-strong);
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: start;
  }
  .page-tagline {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
    max-width: 52ch;
    color: var(--ink);
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 500;
  }
  .page-body {
    margin: 18px 0 0;
    font-size: 16px;
    line-height: 1.6;
    max-width: 54ch;
    color: var(--ink);
  }
  .page-ctas {
    margin-top: 28px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .page-head-image-frame {
    width: 100%;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--canvas-dark);
    border-radius: 2px;
  }
  .page-head-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .page-head-caption {
    margin-top: 14px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
  }
  @media (min-width: 960px) {
    .page-head-grid { grid-template-columns: 1.1fr 1fr; gap: 64px; }
  }

  /* ---------- WHAT GETS FIXED (exact reuse of custom-builds.astro cat-grid odd/even pattern) ---------- */
  .fixed {
    padding: 80px 0;
    background: var(--canvas);
  }
  .fixed-head { margin-bottom: 40px; }
  .fixed h2 {
    font-size: clamp(30px, 4vw, 52px);
    letter-spacing: -0.03em;
    margin-top: 14px;
    max-width: 24ch;
    text-wrap: balance;
  }
  .fixed h2 em { font-style: italic; color: var(--river); font-weight: 400; }
  .fixed-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }
  .fixed-card {
    padding: 28px 0;
    border-bottom: 1px solid var(--rule-strong);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fixed-card:last-child { border-bottom: none; }
  .fixed-num {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .fixed-card h3 {
    font-family: var(--f-serif);
    font-weight: 600;
    font-size: clamp(20px, 2.4vw, 24px);
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--charcoal);
    max-width: 26ch;
  }
  .fixed-card h3 a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
  }
  .fixed-card h3 a:hover { color: var(--rust); border-bottom-color: var(--rust); }
  .fixed-card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 46ch;
  }
  @media (min-width: 720px) {
    .fixed-grid { grid-template-columns: repeat(2, 1fr); column-gap: 48px; border-bottom: none; }
    .fixed-card { padding: 32px 0; border-bottom: 1px solid var(--rule-strong); }
    .fixed-grid > .fixed-card:nth-last-child(-n+2):not(:last-child) { border-bottom: 1px solid var(--rule-strong); }
    .fixed-grid > .fixed-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      border-bottom: none;
    }
  }

  /* ---------- PRICING (exact reuse of services.astro price-list component) ---------- */
  .cat {
    padding: 72px 0;
    background: var(--canvas-light);
    border-top: 1px solid var(--rule-strong);
  }
  .cat-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .cat-num {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .cat h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .price-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .price-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule-strong);
    align-items: baseline;
  }
  .pi-name {
    font-family: var(--f-serif);
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--charcoal);
  }
  .pi-price {
    font-family: var(--f-mono);
    font-size: clamp(14px, 1.6vw, 15px);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--charcoal);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .cat-foot {
    margin: 24px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 60ch;
  }
  .cat-foot a { color: var(--charcoal); border-bottom: 1px solid var(--charcoal); text-decoration: none; }
  .cat-foot a:hover { color: var(--rust); border-bottom-color: var(--rust); }

  /* ---------- HOW IT WORKS (exact reuse of services.astro how-grid component) ---------- */
  .how {
    padding: 88px 0 100px;
    background: var(--canvas);
    border-top: 2px solid var(--charcoal);
  }
  .how h2 {
    font-size: clamp(32px, 4.4vw, 52px);
    letter-spacing: -0.03em;
    margin: 0 auto 36px;
    max-width: 14ch;
    text-align: center;
  }
  .how-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }
  .how-card {
    padding: 32px 16px;
    border-bottom: 1px solid var(--rule-strong);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }
  .how-card:last-child { border-bottom: none; }
  .how-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--river);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: var(--canvas-light);
    flex-shrink: 0;
  }
  .how-icon svg { width: 22px; height: 22px; }
  .how-card h4 {
    font-family: var(--f-serif);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--charcoal);
  }
  .how-card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 42ch;
  }

  /* ---------- GALLERY (exact reuse of portfolio/index.astro portfolio-grid component) ---------- */
  .gallery {
    padding: 88px 0;
    background: var(--canvas-light);
    border-top: 2px solid var(--charcoal);
  }
  .gallery-head { max-width: 64ch; margin-bottom: 44px; }
  .gallery h2 {
    font-size: clamp(30px, 4vw, 52px);
    letter-spacing: -0.03em;
    margin-top: 14px;
    text-wrap: balance;
  }
  .gallery h2 em { font-style: italic; color: var(--river); font-weight: 400; }
  .gallery-intro {
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }
  .gallery-empty {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 56ch;
    padding: 28px 0;
    border-top: 1px solid var(--rule-strong);
